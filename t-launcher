#!/data/data/com.termux/files/usr/bin/bash
# t-launcher v8
# Color-coded file browser for Termux with smart open/run actions.
#  - NEW split screen (Ctrl+S): put a second browser, a shell, a viewer, htop,
#    an add-on or any command next to your files. Copy/move between panes.
#  - NEW menu, grouped: SPLIT · GO · TOOLS · APPS · VIEW · SETUP, with live
#    status and a one-line explanation of whatever you highlight
#  - NEW sort by name / newest / biggest; settings remembered between runs
#  - NEW folder actions (Tab on a folder), copy / move / rename / delete
#  - Enter opens any file with the right thing (topen); Tab = action menu
#  - Add-ons: dropwatch, cardkey, netkey, offset, tdoctor, clipkey, talk, sukey
#  - 10 file managers one tap away (fmget), pkgkey + fkey built in
#  - ".." always goes up; Esc goes back like a browser
#
# Install/upgrade:  bash t-launcher --install    (or MENU → Update t-launcher)
# Requires: fzf  (tmux is installed for you the first time you split)
# ============================================================

set -uo pipefail

VERSION=8
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
QSELF="$(printf '%q' "$SELF")"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/t-launcher"
CONF="$CONF_DIR/settings"
RAW_BASE="https://raw.githubusercontent.com/shaynhahm-lgtm/t-launcher/${T_BRANCH:-main}"

# ---------- Self-install (backs up old version, syncs to GitHub) ----------
if [ "${1:-}" = "--install" ]; then
  TARGET="$(grep -o '[^ =]*launcher[^ ]*\.sh' "$HOME/.zshrc" 2>/dev/null | head -1 \
    | sed -e "s#^[\"']##" -e "s#[\"']\$##" -e "s#~#$HOME#" -e "s#\\\$HOME#$HOME#")"
  [ -n "$TARGET" ] || TARGET="$HOME/bin/termux-launcher.sh"
  [ "$SELF" = "$TARGET" ] && { echo "Already running the installed copy."; exit 0; }
  mkdir -p "$(dirname "$TARGET")" "$HOME/.toolkit-backup"
  if [ -f "$TARGET" ]; then
    cp "$TARGET" "$HOME/.toolkit-backup/old-launcher-$(date +%Y%m%d-%H%M%S).sh"
    echo -e "\033[1;32m  ✓\033[0m Old launcher backed up to ~/.toolkit-backup/"
  fi
  cp "$SELF" "$TARGET" && chmod +x "$TARGET"
  echo -e "\033[1;32m  ✓\033[0m Installed to $TARGET"
  if ! grep -q 'alias t-launcher=' "$HOME/.zshrc" 2>/dev/null; then
    echo "alias t-launcher='bash $TARGET'" >> "$HOME/.zshrc"
    echo -e "\033[1;32m  ✓\033[0m Added t-launcher alias"
  fi
  command -v toolkit-sync >/dev/null && toolkit-sync
  echo -e "\nOpen a new Termux session (or run: source ~/.zshrc), then type: t-launcher"
  exit 0
fi

# ---------- Colors ----------
C_RESET="\033[0m"
C_DIR="\033[1;34m"
C_SCRIPT="\033[1;32m"
C_EXEC="\033[1;31m"
C_ARCHIVE="\033[1;35m"
C_PKG="\033[38;5;208m"
C_WEB="\033[1;36m"
C_TEXT="\033[0;37m"
C_OPT="\033[1;33m"
C_MEDIA="\033[38;5;213m"
C_DOC="\033[38;5;180m"
C_OTHER="\033[0m"
C_DIM="\033[38;5;244m"
C_ACC="\033[1;38;5;51m"
C_WARN="\033[1;33m"
# menu group colors
G_GO="\033[1;34m"; G_SPLIT="\033[1;38;5;51m"; G_TOOLS="\033[1;32m"
G_APPS="\033[38;5;208m"; G_VIEW="\033[1;33m"; G_SETUP="\033[38;5;213m"
G_RUN="\033[1;32m"; G_OPEN="\033[1;36m"; G_INFO="\033[38;5;180m"; G_FILE="\033[1;35m"

MENU_KEY="::MENU::"
MENU_LABEL="Menu: split, add-ons, tools, settings"
FIELDKIT_DIR="$HOME/fieldkit"
DL="/storage/emulated/0/Download"
[ -d "$DL" ] || DL="$HOME/storage/downloads"
ADDONS="dropwatch cardkey netkey offset tdoctor clipkey talk sukey"
ADDON_RAW="$RAW_BASE/addons"
FILE_MANAGERS="yazi mc ranger nnn lf vifm broot clifm fff walk"

# ---------- Settings (remembered between runs) ----------
SHOW_HIDDEN=0; SORT=name; PREVIEW_ON=1; SPLIT_LAYOUT=auto; SPLIT_SIZE=50; LAST_CMD=""
load_settings() {
  [ -f "$CONF" ] || return 0
  local k v
  while IFS='=' read -r k v; do
    case "$k" in
      SHOW_HIDDEN|PREVIEW_ON) [[ $v =~ ^[01]$ ]] && printf -v "$k" '%s' "$v" ;;
      SORT)         case "$v" in name|newest|biggest) SORT="$v" ;; esac ;;
      SPLIT_LAYOUT) case "$v" in auto|stacked|side) SPLIT_LAYOUT="$v" ;; esac ;;
      SPLIT_SIZE)   case "$v" in 50|60|70) SPLIT_SIZE="$v" ;; esac ;;
      LAST_CMD)     LAST_CMD="$v" ;;
    esac
  done < "$CONF"
}
save_settings() {
  mkdir -p "$CONF_DIR" 2>/dev/null || return 0
  printf '%s\n' "SHOW_HIDDEN=$SHOW_HIDDEN" "SORT=$SORT" "PREVIEW_ON=$PREVIEW_ON" \
    "SPLIT_LAYOUT=$SPLIT_LAYOUT" "SPLIT_SIZE=$SPLIT_SIZE" "LAST_CMD=$LAST_CMD" > "$CONF.tmp.$$" \
    && mv -f "$CONF.tmp.$$" "$CONF"
}
load_settings

# ---------- Navigation stack ----------
declare -a NAV_STACK=("$PWD")
current_dir() { printf '%s' "${NAV_STACK[-1]}"; }
push_dir()    { NAV_STACK+=("$1"); }
pop_dir()     { [ "${#NAV_STACK[@]}" -gt 1 ] && unset 'NAV_STACK[-1]'; }

# ---------- Small helpers ----------
need() { command -v "$1" >/dev/null 2>&1; }
msg() {
  echo -e "$1"
  read -n 1 -s -r -p "$(echo -e "${C_DIM}Press any key to continue...${C_RESET}")"
  echo
}
confirm() { local a; read -r -p "$(echo -e "$1") [y/N] " a; [[ $a == [yY]* ]]; }
short() { # ~ for home, /sdcard for shared storage
  local p="$1"
  [[ $p == "$HOME"* ]] && p="~${p#"$HOME"}"
  [[ $p == /storage/emulated/0* ]] && p="/sdcard${p#/storage/emulated/0}"
  printf '%s' "${p:-/}"
}
human() { # bytes -> 1.2MB
  if need numfmt; then numfmt --to=iec --suffix=B "$1" 2>/dev/null || printf '%sB' "$1"
  else printf '%sB' "$1"; fi
}
cols() {
  local r c
  read -r r c < <(stty size </dev/tty 2>/dev/null)
  [[ ${c:-} =~ ^[0-9]+$ ]] || c=50
  printf '%s' "$c"
}

# ---------- fzf look (one style everywhere) ----------
FZF_V=0
fzf_ver() {
  local v maj min
  v="$(fzf --version 2>/dev/null)"; v="${v%% *}"
  maj="${v%%.*}"; min="${v#*.}"; min="${min%%.*}"
  [[ $maj =~ ^[0-9]+$ && $min =~ ^[0-9]+$ ]] && FZF_V=$((maj * 1000 + min))
}
fzf_ver
FZF_STYLE=(--reverse --ansi --cycle --prompt='› ' --pointer='▌'
  --color='fg:252,fg+:255,bg+:236,hl:214,hl+:214,prompt:51,pointer:51,info:244,header:244,spinner:51,marker:214')
if [ "$FZF_V" -ge 42 ]; then
  FZF_STYLE+=(--info=inline-right --separator='─' --border=top
    --color='border:240,label:51,separator:238,scrollbar:240,preview-border:238')
fi
has_labels() { [ "$FZF_V" -ge 42 ]; }

pick() { # pick "Title" option... -> prints the chosen line
  local h="$1"; shift
  local -a o=("${FZF_STYLE[@]}")
  if has_labels; then o+=(--border-label=" $h "); else o+=(--header="$h"); fi
  printf '%s\n' "$@" | fzf "${o[@]}"
}

# Menu rows are "KEY<TAB>display". menu_pick shows the display and prints the KEY.
#   MP="preview command" menu_pick ...   adds a description strip at the bottom
LW=24
set_widths() { local c; c="$(cols)"; LW=$(( c - 27 )); ((LW > 26)) && LW=26; ((LW < 12)) && LW=12; }
row() { # row KEY COLOR GROUP LABEL [STATUS]
  local lbl="$4" n
  n=$(( LW - ${#lbl} )); ((n < 1)) && n=1
  printf '%s\t%b%-6s%b %s%*s%b%s%b\n' "$1" "$2" "$3" "$C_RESET" "$lbl" "$n" '' "$C_DIM" "${5:-}" "$C_RESET"
}
menu_pick() { # menu_pick TITLE HINT [KEY-to-start-on] < rows  -> prints KEY
  local title="$1" hint="$2" start="${3:-}" rows sel pos
  rows="$(cat)"
  local -a o=("${FZF_STYLE[@]}" --delimiter=$'\t' --with-nth=2..)
  if has_labels; then o+=(--border-label=" $title "); [ -n "$hint" ] && o+=(--header="$hint")
  else o+=(--header="$title${hint:+  ·  $hint}"); fi
  if [ -n "$start" ] && [ "$FZF_V" -ge 36 ]; then
    pos="$(printf '%s\n' "$rows" | grep -n -m1 "^$start"$'\t' | cut -d: -f1)"
    [ -n "$pos" ] && o+=(--bind "load:pos($pos)")
  fi
  [ -n "${MP:-}" ] && o+=(--preview "$MP" --preview-window=down,4,border-top)
  # in a short split pane, go full screen while picking, then put the split back
  local zoomed=0 r rc
  if in_tmux && [ "$(popt "$MYPANE" window_zoomed_flag)" = 0 ] && split_active; then
    read -r r _ < <(stty size </dev/tty 2>/dev/null)
    if [ "${r:-99}" -lt 30 ] || [ "$(cols)" -lt 60 ]; then tm resize-pane -Z -t "$MYPANE"; zoomed=1; fi
  fi
  sel="$(printf '%s\n' "$rows" | fzf "${o[@]}")"; rc=$?
  [ "$zoomed" = 1 ] && tm resize-pane -Z -t "$MYPANE"
  [ "$rc" = 0 ] || return 1
  printf '%s' "${sel%%$'\t'*}"
}

# ---------- File type tag (no subshells, fast in big folders) ----------
tag_for() {
  local f="$1" b="${1##*/}"
  case "${b,,}" in
    *.sh|*.bash|*.zsh|*.py|*.pl|*.rb|*.js) TAG="[SCRIPT]"; TC="$C_SCRIPT" ;;
    *.appimage|*.apk|*.deb)                TAG="[PKG]";    TC="$C_PKG" ;;
    *.html|*.htm)                          TAG="[WEB]";    TC="$C_WEB" ;;
    *.jpg|*.jpeg|*.png|*.gif|*.webp|*.bmp|*.heic|*.svg) TAG="[IMAGE]"; TC="$C_MEDIA" ;;
    *.mp3|*.m4a|*.aac|*.flac|*.wav|*.ogg|*.opus)        TAG="[AUDIO]"; TC="$C_MEDIA" ;;
    *.mp4|*.mkv|*.webm|*.avi|*.mov|*.3gp)               TAG="[VIDEO]"; TC="$C_MEDIA" ;;
    *.pdf|*.epub|*.doc|*.docx|*.xls|*.xlsx|*.ppt|*.pptx|*.odt) TAG="[DOC]"; TC="$C_DOC" ;;
    *.db|*.sqlite|*.sqlite3)               TAG="[DB]";     TC="$C_DOC" ;;
    *.zip|*.tar|*.gz|*.tgz|*.bz2|*.xz|*.7z|*.rar|*.zst) TAG="[ARCHIVE]"; TC="$C_ARCHIVE" ;;
    *.txt|*.md|*.conf|*.cfg|*.json|*.yml|*.yaml|*.ini|*.log|*.csv) TAG="[TEXT]"; TC="$C_TEXT" ;;
    *) if [ -x "$f" ]; then TAG="[EXEC]"; TC="$C_EXEC"; else TAG="[FILE]"; TC="$C_OTHER"; fi ;;
  esac
}

# ---------- Listing: dirs first, then files, in the chosen sort ----------
# Each line: "<colored display><TAB><real name>"
LIST_COUNT=0
build_listing() {
  local dir="$1" g t s m name key
  printf '%b%-9s%b %s\t%s\n' "$C_DIR" "[UP]" "$C_RESET" ".." ".."
  printf '%b%-9s%b %b%s%b\t%s\n' "$C_OPT" "[MENU]" "$C_RESET" "$C_OPT" "$MENU_LABEL" "$C_RESET" "$MENU_KEY"
  local -a fa=(-mindepth 1 -maxdepth 1)
  [ "$SHOW_HIDDEN" = 1 ] || fa+=(-not -name '.*')
  case "$SORT" in newest) key='-k4,4nr' ;; biggest) key='-k3,3nr' ;; *) key='-k5,5f' ;; esac
  LIST_COUNT=0
  while IFS=$'\t' read -r g t s m name; do
    [ -n "$name" ] || continue
    LIST_COUNT=$((LIST_COUNT + 1))
    if [ "$t" = d ]; then
      printf '%b%-9s%b %b%s/%b\t%s\n' "$C_DIR" "[DIR]" "$C_RESET" "$C_DIR" "$name" "$C_RESET" "$name"
    else
      tag_for "$dir/$name"
      printf '%b%-9s%b %s\t%s\n' "$TC" "$TAG" "$C_RESET" "$name" "$name"
    fi
  done < <(find "$dir" "${fa[@]}" -printf '%Y\t%s\t%T@\t%f\n' 2>/dev/null \
           | awk -F'\t' 'BEGIN{OFS="\t"} {print ($1=="d" ? 0 : 1), $0}' \
           | LC_ALL=C sort -t $'\t' -k1,1n $key)
}

# ---------- Preview pane ----------
do_preview() {
  local name="$1" cur="${LAUNCH_CUR:-$PWD}" p sz n
  if [ "$name" = "$MENU_KEY" ]; then
    echo -e "${G_SPLIT}SPLIT${C_RESET}  second browser, shell, viewer, htop, add-ons"
    echo -e "${G_GO}GO${C_RESET}     home, Downloads, any folder, new folder"
    echo -e "${G_TOOLS}TOOLS${C_RESET}  add-ons, ~/bin, pkgkey, fkey"
    echo -e "${G_APPS}APPS${C_RESET}   desktop, Fieldkit, other file managers"
    echo -e "${G_VIEW}VIEW${C_RESET}   hidden files, sort, preview"
    echo -e "${G_SETUP}SETUP${C_RESET}  open-with rules, sync, update, keys"
    return
  fi
  if [ "$name" = ".." ]; then p="$(dirname "$cur")"; else p="${cur%/}/$name"; fi
  if [ -d "$p" ]; then
    n="$(find "$p" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)"
    echo -e "${C_DIM}folder · $n $([ "$n" = 1 ] && echo item || echo items) · $(short "$p")${C_RESET}"
    ls -1p --group-directories-first --color=always "$p" 2>/dev/null | head -100
    return
  fi
  [ -e "$p" ] || return
  sz="$(stat -c %s "$p" 2>/dev/null || echo 0)"
  echo -e "${C_DIM}$(human "$sz") · $(date -r "$p" '+%b %d %Y %H:%M' 2>/dev/null)$([ -x "$p" ] && echo ' · executable')${C_RESET}"
  [ "$sz" = 0 ] && { echo "(empty file)"; return; }
  case "${name,,}" in
    *.zip|*.apk|*.jar) need unzip && unzip -l "$p" 2>/dev/null | head -60; return ;;
    *.tar|*.tar.*|*.tgz) tar -tf "$p" 2>/dev/null | head -60; return ;;
    *.7z) need 7z && 7z l "$p" 2>/dev/null | tail -n +14 | head -60; return ;;
    *.jpg|*.jpeg|*.png|*.gif|*.webp|*.bmp|*.heic|*.mp3|*.m4a|*.aac|*.flac|*.wav|*.ogg|*.opus|*.mp4|*.mkv|*.webm|*.avi|*.mov|*.3gp|*.pdf|*.docx|*.xlsx|*.pptx|*.odt|*.epub)
      need file && file -b "$p" | fold -s -w 60
      echo -e "${C_DIM}Enter opens it in the matching Android app.${C_RESET}"; return ;;
  esac
  if grep -Iq . "$p" 2>/dev/null; then
    if need bat; then bat --color=always --style=plain --paging=never --line-range=:120 "$p" 2>/dev/null
    elif need batcat; then batcat --color=always --style=plain --paging=never --line-range=:120 "$p" 2>/dev/null
    else head -c 6000 "$p" | head -120; fi
  else
    if need file; then file -b "$p" | fold -s -w 60; else echo "binary file"; fi
  fi
}

# ---------- Split screen (tmux) ----------
# Each pane t-launcher manages carries tmux pane options:
#   @tl_role  files | shell | view | mon | tool | cmd
#   @tl_label what the pane's title bar says
#   @tl_dir   (browsers) the folder it is showing
#   @tl_list  (browsers) 1 while the file list is on screen, so the other pane can refresh it
MYPANE="${TMUX_PANE:-}"
in_tmux() { [ -n "${TMUX:-}" ] && [ -n "$MYPANE" ]; }
tm() { tmux "$@" 2>/dev/null; }
popt() { [ -n "${1:-}" ] && tm display -p -t "$1" "#{$2}"; }
setp() { in_tmux && tm set -p -t "$MYPANE" "$1" "$2"; }
others() { in_tmux && tm list-panes -t "$MYPANE" -F '#{pane_id}' | grep -vx "$MYPANE"; }
partner() { # first other pane t-launcher owns (optionally of one role)
  local p r
  for p in $(others); do
    r="$(popt "$p" @tl_role)"
    [ -n "$r" ] || continue
    if [ -z "${1:-}" ] || [ "$r" = "$1" ]; then printf '%s' "$p"; return 0; fi
  done
  return 1
}
partner_role() { local p; p="$(partner)" && popt "$p" @tl_role; }
split_active() { [ -n "$(partner)" ]; }
role_name() {
  case "$1" in
    files) echo "file browser" ;; shell) echo "shell" ;; view) echo "viewer" ;;
    mon) echo "system monitor" ;; tool|cmd) echo "command" ;; *) echo "pane" ;;
  esac
}

style_window() { # a title bar on each pane
  tm set -w -t "$MYPANE" pane-border-status top
  tm set -w -t "$MYPANE" pane-border-lines heavy
  tm set -w -t "$MYPANE" pane-border-style 'fg=colour238'
  tm set -w -t "$MYPANE" pane-active-border-style 'fg=colour51'
  tm set -w -t "$MYPANE" pane-border-format \
    '#{?pane_active,#[fg=colour235#,bg=colour51#,bold],#[fg=colour250#,bg=colour238]} #{?#{@tl_label},#{@tl_label},#{pane_current_command}} #[default]'
}
unstyle_window() {
  local o
  for o in pane-border-status pane-border-lines pane-border-style pane-active-border-style pane-border-format; do
    tm set -wu -t "$MYPANE" "$o"
  done
}
style_session() { # only for the tmux session t-launcher started itself
  tm set -t "$MYPANE" mouse on
  tm set -s escape-time 10
  tm set -t "$MYPANE" status-style 'bg=colour235,fg=colour244'
  tm set -t "$MYPANE" status-left '#[fg=colour235,bg=colour51,bold] t-launcher #[default] '
  tm set -t "$MYPANE" status-left-length 16
  tm set -t "$MYPANE" status-right '#[fg=colour244]tap a pane to switch · ^S split '
  tm set -t "$MYPANE" status-right-length 40
  tm set -t "$MYPANE" window-status-format ''
  tm set -t "$MYPANE" window-status-current-format ''
}

ensure_tmux() {
  need tmux && return 0
  echo -e "${C_ACC}Split screen needs tmux. Installing it (one time)...${C_RESET}"
  if need pkg; then pkg install -y tmux; fi
  hash -r; need tmux || { msg "Couldn't install tmux. Try: pkg install tmux"; return 1; }
}

layout_flag() { # -v = top/bottom, -h = side by side
  case "$SPLIT_LAYOUT" in
    stacked) echo -v ;; side) echo -h ;;
    *) if [ "$(cols)" -ge 90 ]; then echo -h; else echo -v; fi ;;
  esac
}
layout_text() {
  case "$SPLIT_LAYOUT" in
    stacked) echo "top/bottom" ;; side) echo "side by side" ;;
    *) if [ "$(cols)" -ge 90 ]; then echo "auto (side)"; else echo "auto (top/bottom)"; fi ;;
  esac
}

# split_open ROLE [ARG] - opens the other pane, or swaps out what's in it
split_open() {
  local role="$1" arg="${2:-}" dir o new label focus=keep sh
  dir="$(current_dir)"
  if ! in_tmux; then
    ensure_tmux || return 1
    save_settings
    exec tmux new-session -c "$dir" -e TL_OWNED=1 bash "$SELF" --split "$role" "$arg" "$dir"
  fi
  sh="$(tm show -gv default-shell)"; [ -n "$sh" ] || sh="${SHELL:-bash}"
  local -a cmd=()
  case "$role" in
    files) cmd=(bash "$SELF" --pane "${arg:-$dir}"); label="FILES" ;;
    shell) cmd=("$sh"); label="SHELL"; focus=new ;;
    view)  if [ -n "$arg" ]; then cmd=(bash "$SELF" --view open "$arg" "$MYPANE"); focus=new  # open a file now
           else cmd=(bash "$SELF" --viewer-idle); fi; label="VIEWER" ;;
    mon)   cmd=(bash "$SELF" --monitor); label="MONITOR" ;;
    tool)  cmd=(bash "$SELF" --run-pane tool "$arg"); label="${arg##*/}"; focus=new ;;
    cmd)   cmd=(bash "$SELF" --run-pane cmd "$arg"); label="CMD ${arg%% *}"; focus=new ;;
    *) return 1 ;;
  esac
  o="$(partner)"
  if [ -n "$o" ]; then
    tm respawn-pane -k -t "$o" -c "$dir" "${cmd[@]}" && new="$o"
  else
    new="$(tm split-window -d -P -F '#{pane_id}' -t "$MYPANE" "$(layout_flag)" \
      -l "$((100 - SPLIT_SIZE))%" -c "$dir" "${cmd[@]}")"
  fi
  [ -n "${new:-}" ] || { msg "Couldn't open the split."; return 1; }
  tm set -p -t "$new" @tl_role "$role"
  tm set -p -t "$new" @tl_label "$label"
  setp @tl_role files
  setp @tl_label "FILES $(short "$dir")"
  style_window
  [ "$focus" = new ] && tm select-pane -t "$new"
  return 0
}

split_close() {
  local p
  for p in $(others); do [ -n "$(popt "$p" @tl_role)" ] && tm kill-pane -t "$p"; done
  unstyle_window
}
side_by_side() { local o; o="$(partner)" || return 1; [ "$(popt "$MYPANE" pane_top)" = "$(popt "$o" pane_top)" ]; }
split_flip() {
  partner >/dev/null || return
  if side_by_side; then SPLIT_LAYOUT=stacked; tm select-layout -t "$MYPANE" even-vertical
  else SPLIT_LAYOUT=side; tm select-layout -t "$MYPANE" even-horizontal; fi
  split_resize; save_settings
}
split_resize() {
  partner >/dev/null || return 0
  if side_by_side; then tm resize-pane -t "$MYPANE" -x "${SPLIT_SIZE}%"
  else tm resize-pane -t "$MYPANE" -y "${SPLIT_SIZE}%"; fi
}

helper_exit() { # a split pane is closing: tidy the window and refresh the browser
  in_tmux || return 0
  local b p n=0
  b="$(partner files)" || return 0
  for p in $(others); do [ "$p" != "$b" ] && [ -n "$(popt "$p" @tl_role)" ] && n=$((n + 1)); done
  [ "$n" = 0 ] && unstyle_window
  [ "$(popt "$b" @tl_list)" = 1 ] && tm run-shell -b "sleep 0.3; tmux send-keys -t $b F5"
  return 0
}

refresh_partner() { # make the other browser re-read its folder
  local p; p="$(partner files)" || return 0
  [ "$(popt "$p" @tl_list)" = 1 ] && tm send-keys -t "$p" F5
  return 0
}

# Open a file in the viewer pane if there is one, otherwise right here
open_file() { # open_file MODE FILE    MODE = open | view | edit
  local mode="$1" file="$2" v
  if v="$(partner view)"; then
    tm respawn-pane -k -t "$v" -c "${file%/*}" bash "$SELF" --view "$mode" "$file" "$MYPANE"
    tm select-pane -t "$v"
    return
  fi
  case "$mode" in
    open) if need topen; then topen --pause "$file"; else less -R "$file"; fi ;;
    view) less -R "$file" ;;
    edit) if need nano; then nano "$file"; else "${EDITOR:-vi}" "$file"; fi ;;
  esac
}

# Send a folder to the other pane: a browser goes there, a shell cd's there
send_folder() {
  local d="$1" p r
  if p="$(partner)"; then
    r="$(popt "$p" @tl_role)"
    case "$r" in
      files) tm respawn-pane -k -t "$p" -c "$d" bash "$SELF" --pane "$d" ;;
      shell) tm send-keys -t "$p" "cd -- $(printf '%q' "$d")" Enter ;;
      *)     split_open files "$d"; return ;;
    esac
    tm select-pane -t "$p"
  else
    split_open files "$d"
  fi
}

# Run a script in the split: typed into a shell pane, otherwise in a run pane
run_in_split() {
  local file="$1" dir="${1%/*}" p c
  if need topen; then c="topen ./$(printf '%q' "${file##*/}")"; else c="bash ./$(printf '%q' "${file##*/}")"; fi
  if p="$(partner shell)"; then
    [ "$(popt "$p" pane_current_path)" = "$dir" ] || c="cd -- $(printf '%q' "$dir") && $c"
    tm send-keys -t "$p" "$c" Enter; tm select-pane -t "$p"
  else
    split_open cmd "cd -- $(printf '%q' "$dir") && $c"
  fi
}

split_menu() {
  local choice o r last="" hint
  while true; do
    set_widths
    o="$(partner)"; r=""; [ -n "$o" ] && r="$(popt "$o" @tl_role)"
    hint="What goes in the other pane?"
    [ -n "$o" ] && hint="Now: $(role_name "$r"). Pick one to swap it."
    choice="$( {
      if [ -n "$o" ]; then
        row sw     "$G_SPLIT" NOW   "Switch to other pane"
        row zoom   "$G_SPLIT" NOW   "Full screen (toggle)"  "this pane"
        row swap   "$G_SPLIT" NOW   "Swap panes"
        row flip   "$G_SPLIT" NOW   "Flip layout"           "$(side_by_side && echo "to top/bottom" || echo "to side by side")"
        row close  "$C_EXEC"  NOW   "Close the split"
      fi
      row files    "$G_GO"    FILES "Second file browser"   "copy & move"
      row shell    "$G_TOOLS" SHELL "Shell"                 "in this folder"
      row view     "$G_OPEN"  VIEW  "Viewer"                "files open there"
      row mon      "$G_APPS"  MON   "System monitor"        "htop"
      row tool     "$G_SETUP" TOOL  "Add-on or tool…"       "offset, netkey…"
      row cmd      "$G_VIEW"  CMD   "Custom command…"       "${LAST_CMD:-anything}"
      row layout   "$C_DIM"   SET   "Layout"                "$(layout_text)"
      row size     "$C_DIM"   SET   "Size"                  "files $SPLIT_SIZE%"
    } | MP="bash $QSELF --describe split-{1}" menu_pick "Split screen" "$hint" "$last")" || return
    last="$choice"
    case "$choice" in
      sw)    tm select-pane -t "$o"; return ;;
      zoom)  tm resize-pane -Z -t "$MYPANE"; return ;;
      swap)  tm swap-pane -d -s "$MYPANE" -t "$o"; return ;;
      flip)  split_flip ;;
      close) split_close; return ;;
      layout)
        case "$SPLIT_LAYOUT" in auto) SPLIT_LAYOUT=stacked ;; stacked) SPLIT_LAYOUT=side ;; *) SPLIT_LAYOUT=auto ;; esac
        save_settings ;;
      size)
        case "$SPLIT_SIZE" in 50) SPLIT_SIZE=60 ;; 60) SPLIT_SIZE=70 ;; *) SPLIT_SIZE=50 ;; esac
        save_settings; split_resize ;;
      files|shell|view|mon) split_open "$choice"; return ;;
      tool)
        local t; t="$(tool_pick)" || continue
        split_open tool "$(command -v "$t" || echo "$t")"; return ;;
      cmd)
        local c
        echo -e "${C_ACC}Command for the other pane${C_RESET} ${C_DIM}(aliases work · Tab completes)${C_RESET}"
        read -r -e -p "$ " -i "$LAST_CMD" c
        [ -n "$c" ] || continue
        LAST_CMD="$c"; save_settings
        split_open cmd "$c"; return ;;
    esac
  done
}

tool_pick() { # add-ons + ~/bin tools -> prints a command name (installs add-ons first)
  local a t choice
  set_widths
  choice="$( {
    for a in $ADDONS; do
      if need "$a"; then row "$a" "$G_TOOLS" ADDON "$a" "$(addon_desc "$a")"
      else row "$a" "$C_DIM" GET "$a" "$(addon_desc "$a")"; fi
    done
    while IFS= read -r t; do
      case " $ADDONS " in *" $t "*) continue ;; esac
      row "$t" "$G_SETUP" BIN "$t" "~/bin"
    done < <(bin_tools)
    need pkgkey && row pkgkey "$G_INFO" PKG pkgkey "packages"
  } | menu_pick "Run in the other pane" "GET = installs on pick")" || return 1
  case " $ADDONS " in
    *" $choice "*) need "$choice" || get_addon "$choice" || { msg "Install of $choice failed."; return 1; } ;;
  esac
  printf '%s' "$choice"
}

# ---------- Programs that run inside a split pane ----------
viewer_idle() {
  clear
  echo -e "\n  ${C_ACC}VIEWER${C_RESET}\n"
  echo -e "  Files you open in the browser"
  echo -e "  show up here.\n"
  echo -e "  ${C_DIM}Enter on a file    opens it here"
  echo -e "  Tab → View / Edit  opens here too"
  echo -e "  Tap the browser    to go back${C_RESET}"
  while :; do read -rsn1 _ 2>/dev/null || sleep 5; done
}
viewer_open() { # MODE FILE BROWSER-PANE
  local mode="$1" file="$2" back="$3"
  tm set -p -t "$MYPANE" @tl_label "VIEWER ${file##*/}"
  case "$mode" in
    open) if need topen; then topen --pause "$file"; else less -R "$file"; fi ;;
    view) less -R "$file" ;;
    edit) if need nano; then nano "$file"; else "${EDITOR:-vi}" "$file"; fi ;;
  esac
  tm set -p -t "$MYPANE" @tl_label "VIEWER"
  [ -n "$back" ] && tm select-pane -t "$back"
  exec bash "$SELF" --viewer-idle
}
monitor_pane() {
  if ! need htop && ! need btop; then
    echo "Installing htop (one time)..."; need pkg && pkg install -y htop; hash -r
  fi
  if need htop; then htop; elif need btop; then btop; else top; fi
}
run_pane() { # KIND WHAT   (tool = a command, cmd = a command line for your shell)
  local kind="$1" what="$2" rc sh="${SHELL:-bash}" k
  case ":$PATH:" in *":$HOME/bin:"*) ;; *) export PATH="$HOME/bin:$PATH" ;; esac
  if [ "$kind" = tool ]; then "$what"; rc=$?
  else "$sh" -ic "$what"; rc=$?; fi
  echo -e "\n${C_DIM}── done (exit $rc) · r = again · any key closes ──${C_RESET}"
  read -rsn1 k
  [ "$k" = r ] && exec bash "$SELF" --run-pane "$kind" "$what"
  helper_exit
  exit 0
}

# ---------- Run helpers ----------
run_in_dir() { # run_in_dir DIR cmd args...
  local d="$1" rc; shift
  (cd "$d" && "$@"); rc=$?
  msg "\n${C_DIM}Finished (exit code $rc).${C_RESET}"
}

extract_here() {
  local file="$1" dir="${1%/*}" l="${1,,}"
  case "$l" in
    *.zip) need unzip || { msg "Run: pkg install unzip"; return; }; run_in_dir "$dir" unzip -o "$file" ;;
    *.7z)  need 7z    || { msg "Run: pkg install 7zip"; return; }; run_in_dir "$dir" 7z x "$file" ;;
    *.tar|*.tar.*|*.tgz) run_in_dir "$dir" tar -xvf "$file" ;;
    *.gz)  run_in_dir "$dir" gunzip -k "$file" ;;
    *.xz)  run_in_dir "$dir" unxz -k "$file" ;;
    *.bz2) run_in_dir "$dir" bunzip2 -k "$file" ;;
  esac
}

# ---------- File operations ----------
xfer() { # xfer cp|mv SRC DESTDIR
  local op="$1" src="$2" ddir="$3" dst
  dst="${ddir%/}/${src##*/}"
  [ "$(readlink -f "$src")" = "$(readlink -f "$dst")" ] && { msg "That's the same place."; return 1; }
  if [ -e "$dst" ]; then
    confirm "${C_WARN}$(short "$dst") already exists. Replace it?${C_RESET}" || return 1
    rm -rf -- "$dst" || { msg "Couldn't remove the old one."; return 1; }
  fi
  if [ "$op" = cp ]; then echo "Copying ${src##*/} → $(short "$ddir") ..."; cp -r -- "$src" "$dst"
  else echo "Moving ${src##*/} → $(short "$ddir") ..."; mv -- "$src" "$dst"; fi \
    || { msg "That didn't work (check space and permissions)."; return 1; }
  refresh_partner
  return 0
}
ask_dest() { # prompt for a destination folder (Tab completes)
  local d
  read -r -e -p "To folder: " -i "$(short "$(current_dir)")/" d
  d="${d/#\~/$HOME}"
  [ -n "$d" ] || return 1
  if [ ! -d "$d" ]; then
    confirm "$(short "$d") doesn't exist. Create it?" && mkdir -p -- "$d" || return 1
  fi
  printf '%s' "$d"
}
rename_item() {
  local p="$1" n
  read -r -e -p "New name: " -i "${p##*/}" n
  [ -n "$n" ] && [ "$n" != "${p##*/}" ] || return
  [[ $n == */* ]] && { msg "Names can't contain /"; return; }
  [ -e "${p%/*}/$n" ] && { msg "Something called $n is already here."; return; }
  mv -- "$p" "${p%/*}/$n" || msg "Rename failed."
  refresh_partner
}
delete_item() {
  local p="$1" what="file"
  [ -d "$p" ] && what="folder and everything in it"
  confirm "${C_EXEC}Delete $(short "$p") ($what)? This can't be undone.${C_RESET}" || return
  if rm -rf -- "$p"; then echo "Deleted."; else msg "Delete failed."; fi
  refresh_partner
}

# ---------- fkey: turn its suggestions into runnable commands ----------
# Loads fkey's own lookup table (no changes to fkey) and captures its commands.
fkey_cmds() {
  local fk; fk="$(command -v fkey)" || return 1
  bash -c '
    eval "$(sed "/^case \"\$1\" in/,\$d" "$1")"
    cmd(){ printf "%s\t%s\n" "$1" "$2" >&3; }
    lookup "$(get_ext "$2")" 3>&1 >/dev/null 2>&1
  ' _ "$fk" "$1"
}

fill_name() { # swap fkey placeholders (file.tar.gz, yourfile.x, in.mp4) for the real name
  local s="$1" q="$2" out="" m re='(^|[[:space:](/'"'"'])(yourfile|file|in)\.[A-Za-z0-9.]+'
  while [[ $s =~ $re ]]; do
    m="${BASH_REMATCH[0]}"
    out+="${s%%"$m"*}${BASH_REMATCH[1]}$q"
    s="${s#*"$m"}"
  done
  printf '%s' "$out$s"
}

fkey_menu() {
  local file="$1" base="${1##*/}" dir="${1%/*}" q c d choice it i=0
  q="$(printf '%q' "$base")"
  local -a cmds=() items=()
  while IFS=$'\t' read -r c d; do
    c="$(fill_name "$c" "$q")"
    printf -v it '%s\t%s\t%b# %s%b' "$i" "$c" "$C_DIM" "$d" "$C_RESET"
    cmds+=("$c"); items+=("$it"); i=$((i+1))
  done < <(fkey_cmds "$file")
  [ "${#cmds[@]}" -eq 0 ] && { msg "fkey has no commands for this file type."; return; }
  local -a o=("${FZF_STYLE[@]}" --delimiter $'\t' --with-nth=2,3 --header="pick one, edit it, Enter runs it")
  has_labels && o+=(--border-label=" fkey · $base ")
  choice="$(printf '%s\n' "${items[@]}" | fzf "${o[@]}")" || return
  c="${cmds[${choice%%$'\t'*}]}"
  read -r -e -p "$ " -i "$c" c
  [ -z "$c" ] && return
  run_in_dir "$dir" bash -c "$c"
}

# ---------- pkgkey: searchable package picker with live preview ----------
pkgkey_menu() {
  local sel pkg
  local -a o=("${FZF_STYLE[@]}" --header="type to search · Esc = back"
    --preview 'pkgkey {1} </dev/null 2>/dev/null' --preview-window=down,50%,border-top)
  has_labels && o+=(--border-label=" Packages ")
  while true; do
    sel="$(pkgkey -l 2>/dev/null | fzf "${o[@]}")" || return
    pkg="${sel%% *}"; [ -z "$pkg" ] && return
    clear; pkgkey "$pkg"
    msg ""
  done
}

# ---------- Action menus ----------
file_actions() {
  local file="$1" base="${1##*/}" dir="${1%/*}" l choice name="" how="" ob="" od="" pr="" vp="" sb=""
  l="${base,,}"
  set_widths
  ob="$(partner files)" && od="$(popt "$ob" @tl_dir)"
  vp="$(partner view)"
  pr="$(partner_role)"
  need topen && how="$(topen -n "$file" 2>/dev/null | sed -n 's/^  opens with: //p')"
  sb="$(head -c 2 "$file" 2>/dev/null | tr -d '\0')"
  local -a seen=(); local starred=0
  act() { # act KEY COLOR GROUP LABEL [STATUS]  (first one wins, only one ★)
    local s lbl="$4"; for s in "${seen[@]}"; do [ "$s" = "$1" ] && return; done
    seen+=("$1")
    if [[ $lbl == "★ "* ]]; then
      if [ "$starred" = 1 ]; then lbl="${lbl#★ }"; else starred=1; fi
    fi
    row "$1" "$2" "$3" "$lbl" "${5:-}"
  }

  choice="$( {
    # best guess first, starred
    [ -n "$how" ] && act open "$G_OPEN" OPEN "★ Open" "$how"
    case "$l" in
      *.py)          act py   "$G_RUN"  RUN  "★ Run with python" ;;
      *.sh|*.bash)   act bash "$G_RUN"  RUN  "★ Run with bash" ;;
      *.zsh)         act zsh  "$G_RUN"  RUN  "★ Run with zsh" ;;
      *.js)          act node "$G_RUN"  RUN  "★ Run with node" ;;
      *.html|*.htm)  act web  "$G_OPEN" OPEN "★ Open in browser" ;;
      *.apk)         need apkscan && act apkscan "$G_INFO" INFO "★ Scan with apkscan" ;;
      *.zip|*.tar|*.tar.*|*.tgz|*.gz|*.bz2|*.xz|*.7z) act extract "$G_FILE" FILE "★ Extract here" ;;
      *.txt|*.md|*.conf|*.cfg|*.json|*.yml|*.yaml|*.ini|*.log|*.csv) act view "$G_OPEN" OPEN "★ View" ;;
    esac
    { [ "$sb" = '#!' ] || [ -x "$file" ]; } && act direct "$G_RUN" RUN "Run it directly" "./$base"
    # split screen
    if [ -n "$od" ] && [ "$od" != "$dir" ]; then
      act copy "$G_SPLIT" SPLIT "Copy to other pane" "→ ${od##*/}/"
      act move "$G_SPLIT" SPLIT "Move to other pane" "→ ${od##*/}/"
    fi
    case "$pr" in ""|shell|tool|cmd|mon)
      case "$l" in *.sh|*.bash|*.zsh|*.py|*.js|*.pl|*.rb)
        act runsplit "$G_SPLIT" SPLIT "Run in split pane" "${pr:+in the $pr}" ;; esac ;;
    esac
    [ -z "$pr" ] && act viewsplit "$G_SPLIT" SPLIT "Open in a viewer pane"
    # open
    act view "$G_OPEN" OPEN "View" "${vp:+in viewer}"
    act edit "$G_OPEN" OPEN "Edit (nano)" "${vp:+in viewer}"
    # run
    act bash   "$G_RUN" RUN "Run with bash"
    act py     "$G_RUN" RUN "Run with python"
    act custom "$G_RUN" RUN "Run with…" "perl, ruby, node…"
    # info
    need fkey && act fcmds "$G_INFO" INFO "Commands for this file" "fkey"
    need fkey && act fwhat "$G_INFO" INFO "What is this?" "fkey"
    [ "$dir" = "${PREFIX:-/none}/bin" ] && need pkgkey && act which "$G_INFO" INFO "Which package is it from?" "pkgkey"
    # file
    act install "$G_FILE" FILE "Install as a command" "~/bin"
    act chmod   "$G_FILE" FILE "Make executable" "chmod +x"
    act copyto  "$G_FILE" FILE "Copy to…"
    act moveto  "$G_FILE" FILE "Move to…"
    act rename  "$G_FILE" FILE "Rename"
    act delete  "$C_EXEC" FILE "Delete"
  } | menu_pick "$base" "★ = best guess · Esc = back")" || return

  case "$choice" in
    open)    open_file open "$file" ;;
    bash)    chmod +x "$file" 2>/dev/null; run_in_dir "$dir" bash "$file" ;;
    zsh)     chmod +x "$file" 2>/dev/null; run_in_dir "$dir" zsh "$file" ;;
    node)    run_in_dir "$dir" node "$file" ;;
    py)      chmod +x "$file" 2>/dev/null
             if need python; then run_in_dir "$dir" python "$file"; else run_in_dir "$dir" python3 "$file"; fi ;;
    direct)  chmod +x "$file" 2>/dev/null; run_in_dir "$dir" "./$base" ;;
    custom)
      read -r -e -p "Interpreter (e.g. node, perl, ruby): " name
      if [ -n "$name" ] && need "$name"; then run_in_dir "$dir" "$name" "$file"
      else msg "'$name' not found. Nothing was run."; fi ;;
    web)     termux-open "$file" 2>/dev/null || termux-open-url "file://$file" ;;
    apkscan) run_in_dir "$dir" apkscan "$file" ;;
    extract) extract_here "$file" ;;
    copy)    xfer cp "$file" "$od" ;;
    move)    xfer mv "$file" "$od" ;;
    runsplit) chmod +x "$file" 2>/dev/null; run_in_split "$file" ;;
    viewsplit) split_open view "$file" ;;
    fcmds)   fkey_menu "$file" ;;
    fwhat)   run_in_dir "$dir" fkey "$file" ;;
    which)   run_in_dir "$dir" pkgkey -c "$base" ;;
    view)    open_file view "$file" ;;
    edit)    open_file edit "$file" ;;
    install)
      read -r -e -p "Command name: " -i "${base%.*}" name
      [ -z "$name" ] && return
      mkdir -p "$HOME/bin"
      if cp "$file" "$HOME/bin/$name" && chmod +x "$HOME/bin/$name"; then
        msg "Installed. Type '$name' from anywhere."
      else msg "Copy failed."; fi ;;
    chmod)
      if chmod +x "$file"; then msg "chmod +x applied to $base."
      else msg "chmod failed on $base (check permissions)."; fi ;;
    copyto)  local d; d="$(ask_dest)" && xfer cp "$file" "$d" ;;
    moveto)  local d; d="$(ask_dest)" && xfer mv "$file" "$d" ;;
    rename)  rename_item "$file" ;;
    delete)  delete_item "$file" ;;
  esac
}

dir_actions() {
  local d="$1" base="${1##*/}" choice ob="" od="" pr=""
  set_widths
  ob="$(partner files)" && od="$(popt "$ob" @tl_dir)"
  pr="$(partner_role)"
  choice="$( {
