# ---------- Launchers ----------
HAS_DESK=""
has_desk() { # checked once: desk as a command, or as a zsh alias/function
  if [ -z "$HAS_DESK" ]; then
    if need desk || { need zsh && zsh -ic 'whence -w desk' </dev/null >/dev/null 2>&1; }
    then HAS_DESK=1; else HAS_DESK=0; fi
  fi
  [ "$HAS_DESK" = 1 ]
}
launch_desk() {
  if need desk; then desk
  else zsh -ic 'desk' || msg "Couldn't find the desk command."; fi
}
launch_fieldkit() {
  [ -d "$FIELDKIT_DIR" ] || { msg "~/fieldkit not found."; return; }
  if ! pgrep -f "http.server 8080" >/dev/null 2>&1; then
    (cd "$FIELDKIT_DIR" && nohup python3 -m http.server 8080 >/dev/null 2>&1 &)
    sleep 1
  fi
  termux-open-url "http://localhost:8080/index.html"
}

bin_tools() {
  local t
  shopt -s nullglob
  for t in "$HOME/bin"/*; do [ -f "$t" ] && [ -x "$t" ] && printf '%s\n' "${t##*/}"; done
  shopt -u nullglob
}
tools_menu() {
  local choice t
  [ -n "$(bin_tools)" ] || { msg "No tools in ~/bin yet."; return; }
  set_widths
  choice="$( {
    while IFS= read -r t; do row "$t" "$G_SETUP" BIN "$t"; done < <(bin_tools)
  } | menu_pick "My tools (~/bin)" "runs in $(short "$(current_dir)") · Esc = back")" || return
  local -a args=()
  read -r -e -p "Arguments for $choice (Enter for none): " -a args
  run_in_dir "$(current_dir)" "$HOME/bin/$choice" "${args[@]}"
}

options_menu() {
  local fm choice
  set_widths
  choice="$( {
    for fm in $FILE_MANAGERS; do
      if need "$fm"; then row "$fm" "$G_TOOLS" ON "$fm"
      else row "$fm" "$C_DIM" GET "$fm" "installs on pick"; fi
    done
    need fmget && row fmget "$G_SETUP" SETUP "Get file managers" "fmget"
  } | menu_pick "Open $(short "$(current_dir)") with" "Esc = back")" || return
  [ "$choice" = fmget ] && { fmget; msg ""; return; }
  fm="$choice"
  if ! need "$fm"; then
    if need fmget; then fmget "$fm" || { msg "Install of $fm failed."; return; }
    else pkg install -y "$fm" || { msg "Install of $fm failed."; return; }; fi
    hash -r
  fi
  (cd "$(current_dir)" && "$fm") || msg "$fm exited with an error."
}

# ---------- Add-ons: extra tools, installed on first pick ----------
addon_desc() {
  case "$1" in
    dropwatch) echo "auto-handles downloads" ;;
    cardkey)   echo "Cardputer over Wi-Fi" ;;
    netkey)    echo "what's on your Wi-Fi" ;;
    offset)    echo "pipe offset & grade" ;;
    tdoctor)   echo "check & fix Termux" ;;
    clipkey)   echo "clipboard history" ;;
    talk)      echo "voice commands" ;;
    sukey)     echo "near-root (Shizuku)" ;;
  esac
}
get_addon() { # downloads an add-on into ~/bin (they expect to live there)
  local a="$1" tmp
  mkdir -p "$HOME/bin"; tmp="$HOME/bin/.$a.part"
  echo "Installing $a..."
  curl -fsSL "$ADDON_RAW/$a" -o "$tmp" && mv -f "$tmp" "$HOME/bin/$a" && chmod +x "$HOME/bin/$a" \
    || { rm -f "$tmp"; return 1; }
  case ":$PATH:" in *":$HOME/bin:"*) ;; *) export PATH="$HOME/bin:$PATH" ;; esac
  [ "$a" = dropwatch ] && "$HOME/bin/dropwatch" install
  [ "$a" = clipkey ] && "$HOME/bin/clipkey" setup
  hash -r
}
addons_count() { local a n=0; for a in $ADDONS; do need "$a" && n=$((n+1)); done; echo "$n"; }
addons_menu() {
  local a choice last=""
  while true; do
    set_widths
    choice="$( {
      for a in $ADDONS; do
        if need "$a"; then row "$a" "$G_TOOLS" ON "$a" "$(addon_desc "$a")"
        else row "$a" "$C_DIM" GET "$a" "$(addon_desc "$a")"; fi
      done
      row all "$G_SETUP" GET "Install all add-ons" "$(addons_count) of 8 now"
    } | menu_pick "Add-ons" "GET = installs on pick · Esc = back" "$last")" || return
    last="$choice"
    if [ "$choice" = all ]; then
      for a in $ADDONS; do need "$a" || get_addon "$a" || echo "Install of $a failed."; done
      msg "\nDone."; continue
    fi
    a="$choice"
    if ! need "$a"; then get_addon "$a" || { msg "Install of $a failed."; continue; }; fi
    (cd "$(current_dir)" && "$a")
    msg ""
  done
}

# ---------- Main menu ----------
describe() {
  local d
  case "$1" in
    split)    d="Put something next to your files: a second browser to copy/move between, a shell, a viewer, htop, an add-on, or any command." ;;
    home)     d="Jump to your Termux home folder (~)." ;;
    dl)       d="Jump to your phone's Download folder, where browsers and apps save files." ;;
    goto)     d="Type any path (Tab completes it) and jump straight there." ;;
    mkdir)    d="Make a new folder inside the one you're looking at." ;;
    addons)   d="Eight optional tools. Not installed yet? Pick one and it installs itself." ;;
    bin)      d="Run any of your own commands in ~/bin, from the folder you're in." ;;
    pkgkey)   d="Search every installed package, see the commands it gave you, run them or read their help." ;;
    fkey)     d="Type an extension (apk, tar.gz…) to see what that file type is and how to work with it." ;;
    desk)     d="Start the XFCE desktop (your desk command)." ;;
    fieldkit) d="Serve ~/fieldkit on localhost:8080 and open it in your browser." ;;
    fm)       d="Open this folder in yazi, mc, ranger, nnn, lf and more. Missing ones install when picked." ;;
    hidden)   d="Show or hide dotfiles (.config, .zshrc…). Remembered next time." ;;
    sort)     d="By name, newest first, or biggest first. Newest first is handy in Downloads. Remembered." ;;
    preview)  d="The bottom pane that shows what's inside a file or folder. Ctrl+P flips it any time; this sets the default." ;;
    topen)    d="See what opens what, or add your own rules (e.g.  md = glow -p {})." ;;
    sync)     d="Back up your toolkit to GitHub (toolkit-sync)." ;;
    update)   d="Download the newest t-launcher and restart into it. Your settings stay." ;;
    keys)     d="Every key and gesture on one page." ;;
    split-sw)     d="Jump to the other pane. Tapping it works too, or Ctrl+W from the file list." ;;
    split-zoom)   d="Make this pane fill the screen. Pick it again to bring the split back." ;;
    split-swap)   d="Trade places with the other pane." ;;
    split-flip)   d="Switch between top/bottom and side by side." ;;
    split-close)  d="Close the other pane and go back to one screen." ;;
    split-files)  d="A second file browser. Tab on a file → Copy / Move to other pane, Midnight Commander style." ;;
    split-shell)  d="A normal prompt in the folder you're in. Tab on a script → Run in split pane types it there." ;;
    split-view)   d="Files you open (Enter, View, Edit) show up over there, so your file list stays put." ;;
    split-mon)    d="htop: CPU, memory and what's running. Installs itself the first time." ;;
    split-tool)   d="Run an add-on or one of your ~/bin tools next to your files, like offset or netkey." ;;
    split-cmd)    d="Type any command, aliases included (serve, myip…). Remembered for next time." ;;
    split-layout) d="auto = top/bottom on a phone held upright, side by side when the screen is wide." ;;
    split-size)   d="How much of the screen the file browser gets: 50, 60 or 70%." ;;
    *) d="" ;;
  esac
  printf '%s\n' "$d" | fold -s -w "$(( ${FZF_PREVIEW_COLUMNS:-50} - 1 ))"
}

keys_help() {
  {
    echo -e "${C_ACC}t-launcher v$VERSION · keys${C_RESET}\n"
    echo -e "${G_GO}FILES${C_RESET}"
    echo -e "  Enter        open it with the right thing"
    echo -e "  Tab, Ctrl+O  actions for that file or folder"
    echo -e "  Esc          back one step, like a browser"
    echo -e "  ..           up one folder"
    echo -e "  type         search; try  script  dir  .apk"
    echo -e "  Ctrl+P       preview on / off"
    echo -e "  Ctrl+R       refresh\n"
    echo -e "${G_SPLIT}SPLIT SCREEN${C_RESET}"
    echo -e "  Ctrl+S       split menu"
    echo -e "  tap a pane   switch to it (t-launcher's own"
    echo -e "               session; in yours: Ctrl+b o)"
    echo -e "  Ctrl+W       jump to the other pane"
    echo -e "  Tab on file  Copy / Move to other pane,"
    echo -e "               Run in split pane (scripts)"
    echo -e "  split menu   swap · flip · full screen · close"
    echo -e "  Leaving t-launcher closes the split"
    echo -e "  (a shell pane stays open).\n"
    echo -e "${G_SETUP}MENU${C_RESET}"
    echo -e "  It's searchable: type  sort  or  go"
    echo -e "\n${C_DIM}q closes this page${C_RESET}"
  } | less -R
}

main_menu() {
  local choice last="" pr sst nbin nfm fm x
  while true; do
    set_widths
    pr="$(partner_role)"; sst="off"; [ -n "$pr" ] && sst="on: $(role_name "$pr")"
    nbin="$(bin_tools | wc -l)"
    nfm=0; for fm in $FILE_MANAGERS; do need "$fm" && nfm=$((nfm+1)); done
    choice="$( {
      row split    "$G_SPLIT" SPLIT "Split screen…"      "$sst"
      row home     "$G_GO"    GO    "Home"               "~"
      row dl       "$G_GO"    GO    "Downloads"          "${DL##*/}"
      row goto     "$G_GO"    GO    "Go to folder…"
      row mkdir    "$G_GO"    GO    "New folder here"
      row addons   "$G_TOOLS" TOOLS "Add-ons"            "$(addons_count) of 8 installed"
      [ -d "$HOME/bin" ] && row bin "$G_TOOLS" TOOLS "My tools (~/bin)" "$nbin tools"
      need pkgkey  && row pkgkey "$G_TOOLS" TOOLS "Packages"   "pkgkey"
      need fkey    && row fkey   "$G_TOOLS" TOOLS "File types" "fkey"
      has_desk     && row desk   "$G_APPS"  APPS  "Desktop (XFCE)"
      [ -d "$FIELDKIT_DIR" ] && row fieldkit "$G_APPS" APPS "Fieldkit" "localhost:8080"
      row fm       "$G_APPS"  APPS  "Other file managers" "$nfm installed"
      row hidden   "$G_VIEW"  VIEW  "Hidden files"       "$([ "$SHOW_HIDDEN" = 1 ] && echo shown || echo hidden)"
      row sort     "$G_VIEW"  VIEW  "Sort"               "$(case $SORT in newest) echo "newest first";; biggest) echo "biggest first";; *) echo "by name";; esac)"
      row preview  "$G_VIEW"  VIEW  "Preview pane"       "$([ "$PREVIEW_ON" = 1 ] && echo on || echo off)"
      need topen   && row topen "$G_SETUP" SETUP "Open-with rules" "topen"
      need toolkit-sync && row sync "$G_SETUP" SETUP "Sync toolkit to GitHub"
      row update   "$G_SETUP" SETUP "Update t-launcher"  "v$VERSION"
      row keys     "$G_SETUP" SETUP "Keys & tips"
    } | MP="bash $QSELF --describe {1}" menu_pick "Menu" "type to search · Esc = back" "$last")" || return
    last="$choice"
    case "$choice" in
      split)    split_menu; return ;;
      home)     push_dir "$HOME"; return ;;
      dl)       push_dir "$DL"; return ;;
      goto)
        read -r -e -p "Go to: " -i "$(short "$(current_dir)")/" x
        x="${x/#\~/$HOME}"
        if [ -d "$x" ]; then push_dir "$(readlink -f "$x")"; return; else msg "Not a folder: $x"; fi ;;
      mkdir)
        read -r -e -p "New folder name: " x
        [ -n "$x" ] || continue
        if mkdir -p -- "$(current_dir)/$x"; then refresh_partner; return; else msg "Couldn't create $x"; fi ;;
      addons)   addons_menu ;;
      bin)      tools_menu ;;
      pkgkey)   pkgkey_menu ;;
      fkey)
        read -r -e -p "Extension or filename (e.g. apk, tar.gz): " x
        [ -n "$x" ] && { fkey "$x"; msg ""; } ;;
      desk)     launch_desk ;;
      fieldkit) launch_fieldkit ;;
      fm)       options_menu ;;
      hidden)   SHOW_HIDDEN=$((1 - SHOW_HIDDEN)); save_settings ;;
      sort)     case "$SORT" in name) SORT=newest ;; newest) SORT=biggest ;; *) SORT=name ;; esac; save_settings ;;
      preview)  PREVIEW_ON=$((1 - PREVIEW_ON)); save_settings ;;
      topen)
        case "$(pick "topen" "Show what opens what" "Add my own rules")" in
          "Show what opens what") topen -l | less -R ;;
          "Add my own rules")     topen -e ;;
        esac ;;
      sync)     toolkit-sync; msg "\nSync finished." ;;
      update)   update_self ;;
      keys)     keys_help ;;
    esac
  done
}

update_self() {
  need curl || { msg "Needs curl: pkg install curl"; return; }
  echo -e "${C_ACC}Updating t-launcher...${C_RESET}"
  if curl -fsSL "$RAW_BASE/install.sh" | bash; then
    save_settings
    echo "Restarting..."; sleep 1
    exec bash "$SELF" "$(current_dir)"
  else msg "Update failed (no connection?)."; fi
}

# ---------- Main loop ----------
make_header() { # make_header COUNT SPLIT(0/1)
  local extra="" keys
  [ "$SHOW_HIDDEN" = 1 ] && extra+=" · +hidden"
  case "$SORT" in newest) extra+=" · newest" ;; biggest) extra+=" · biggest" ;; esac
  if [ "$2" = 1 ]; then  # the pane's title bar already shows the folder
    printf '%s' "$1 $([ "$1" = 1 ] && echo item || echo items)$extra · Tab actions · ^S · ^W"
  else
    keys="Enter open · Tab actions · ^S split · Esc back"
    need topen || keys="Enter actions · ^S split · Esc back"
    printf '%s\n%s' "$(short "$LAUNCH_CUR") · $1 $([ "$1" = 1 ] && echo item || echo items)$extra" "$keys"
  fi
}
count_entries() {
  local -a fa=(-mindepth 1 -maxdepth 1); [ "$SHOW_HIDDEN" = 1 ] || fa+=(-not -name '.*')
  find "$1" "${fa[@]}" -printf . 2>/dev/null | wc -c
}
RELOAD="reload(bash $QSELF --list)"
[ "$FZF_V" -ge 45 ] && RELOAD+="+transform-header(bash $QSELF --header)"

cleanup() { # leaving: close the helper panes this browser opened (a shell stays)
  # only on a normal exit; if the pane was swapped out (respawned) leave it alone
  in_tmux && [ "${NORMAL_EXIT:-}" = 1 ] || return 0
  local p r x
  if [ -n "${TL_SECOND:-}" ]; then helper_exit
  else
    for p in $(others); do
      r="$(popt "$p" @tl_role)"
      [ -n "$r" ] && [ "$r" != shell ] && tm kill-pane -t "$p"
    done
    unstyle_window
  fi
  for x in @tl_role @tl_label @tl_dir @tl_list; do tm set -pu -t "$MYPANE" "$x"; done
}

main() {
  need fzf || { echo -e "${C_EXEC}fzf is not installed.${C_RESET} Run: pkg install fzf"; exit 1; }
  local out key sel base target hdr up rc listing count keys
  if in_tmux; then setp @tl_role files; trap cleanup EXIT; fi
  [ "${TL_OWNED:-}" = 1 ] && in_tmux && style_session
  if [ -n "${PENDING_SPLIT:-}" ]; then split_open "$PENDING_SPLIT" "${PENDING_ARG:-}"; PENDING_SPLIT=""; fi

  while true; do
    export LAUNCH_CUR; LAUNCH_CUR="$(current_dir)"
    if [ ! -d "$LAUNCH_CUR" ]; then # folder vanished (moved/deleted): step back
      if [ "${#NAV_STACK[@]}" -gt 1 ]; then pop_dir; else NAV_STACK=("$HOME"); fi
      continue
    fi
    if in_tmux; then setp @tl_dir "$LAUNCH_CUR"; setp @tl_label "FILES $(short "$LAUNCH_CUR")"; fi

    listing="$(build_listing "$LAUNCH_CUR"; printf '\034%s' "$LIST_COUNT")"
    count="${listing##*$'\034'}"; listing="${listing%$'\034'*}"; listing="${listing%$'\n'}"

    local split=0 rows
    split_active && split=1
    hdr="$(make_header "$count" "$split")"
    read -r rows _ < <(stty size </dev/tty 2>/dev/null); [[ ${rows:-} =~ ^[0-9]+$ ]] || rows=40

    local -a o=("${FZF_STYLE[@]}" --delimiter=$'\t' --with-nth=1
      --header="$hdr" --expect=tab,ctrl-o,ctrl-s
      --preview "bash $QSELF --preview {2}" --bind 'ctrl-p:toggle-preview'
      --bind "f5:$RELOAD,ctrl-r:$RELOAD")
    # short pane (phone split): preview starts hidden, Ctrl+P still shows it
    if [ "$PREVIEW_ON" = 1 ] && [ "$rows" -ge 30 ]; then o+=(--preview-window=down,40%,border-top)
    else o+=(--preview-window=down,50%,border-top,hidden); fi
    in_tmux && o+=(--bind 'ctrl-w:execute-silent(tmux select-pane -t :.+)')
    if [ "$split" = 1 ]; then o+=(--border=none)
    elif has_labels; then o+=(--border-label=" t-launcher "); fi

    setp @tl_list 1
    out="$(printf '%s\n' "$listing" | fzf "${o[@]}")"; rc=$?
    setp @tl_list 0
    key="${out%%$'\n'*}"
    sel=""; [[ $out == *$'\n'* ]] && sel="${out#*$'\n'}"

    if [ "$key" = ctrl-s ]; then split_menu; continue; fi
    if [ "$rc" = 130 ]; then
      if [ "${#NAV_STACK[@]}" -gt 1 ]; then pop_dir; continue; else break; fi
    fi
    [ -n "$sel" ] || continue

    base="${sel#*$'\t'}"
    case "$base" in
      ..)
        up="$(dirname "$LAUNCH_CUR")"
        if [ "${#NAV_STACK[@]}" -gt 1 ] && [ "${NAV_STACK[-2]}" = "$up" ]; then pop_dir
        else push_dir "$up"; fi ;;
      "$MENU_KEY") main_menu ;;
      *)
        target="${LAUNCH_CUR%/}/$base"
        if [ -d "$target" ]; then
          if [ -n "$key" ]; then dir_actions "$target"; else push_dir "$target"; fi
        elif [ -e "$target" ] || [ -L "$target" ]; then
          if [ -z "$key" ] && need topen; then open_file open "$target"
          else file_actions "$target"; fi
        else msg "That entry no longer exists - refreshing."; fi ;;
    esac
  done
  NORMAL_EXIT=1
}

# ---------- Entry points ----------
case "${1:-}" in
  --list)        build_listing "${LAUNCH_CUR:-$PWD}"; exit 0 ;;
  --header)      LAUNCH_CUR="${LAUNCH_CUR:-$PWD}"; s=0; split_active && s=1
                 make_header "$(count_entries "$LAUNCH_CUR")" "$s"; exit 0 ;;
  --preview)     do_preview "${2:-}"; exit 0 ;;
  --describe)    describe "${2:-}"; exit 0 ;;
  --viewer-idle) viewer_idle; exit 0 ;;
  --view)        viewer_open "${2:-open}" "${3:-}" "${4:-}"; exit 0 ;;
  --monitor)     monitor_pane; helper_exit; exit 0 ;;
  --run-pane)    run_pane "${2:-cmd}" "${3:-}"; exit 0 ;;
  --pane)        [ -d "${2:-}" ] && NAV_STACK=("$(readlink -f "$2")"); TL_SECOND=1; main ;;
  --split)       PENDING_SPLIT="${2:-}"; PENDING_ARG="${3:-}"
                 [ -d "${4:-}" ] && NAV_STACK=("$(readlink -f "$4")"); main ;;
  *)             [ -d "${1:-}" ] && NAV_STACK=("$(readlink -f "$1")"); main ;;
esac
