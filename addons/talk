#!/data/data/com.termux/files/usr/bin/bash
# talk — voice commands for Termux
#
#   talk                  listen once and run the matching command
#   talk loop             keep listening until you say "stop"
#   talk WORDS            act as if you said WORDS (no mic needed)
#   talk add "PHRASE" "COMMAND"
#   talk list             show everything it understands
#   talk edit             open the command list in your editor
#   talk -q ...           quiet: no spoken replies
#
# If it doesn't recognize what you said, pick the right command from the
# list and it learns that phrase for next time.

set -u

CONF="${TALK_CONF:-$HOME/.config/talk/commands.conf}"
SPEAK=1
G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; C=$'\e[36m'; D=$'\e[2m'; N=$'\e[0m'
SELF=$(readlink -f "${BASH_SOURCE[0]}")

die() { echo "${R}talk:${N} $*" >&2; exit 1; }

write_default() {
  mkdir -p "${CONF%/*}"
  cat > "$CONF" <<'EOF'
# talk — voice commands
# Format:   phrase, another phrase = command
# Commands run in your normal shell, so aliases work too.
# If several phrases match what you said, the longest one wins.

launcher, menu, open launcher       = t-launcher
update, upgrade, update everything  = pkg update -y && pkg upgrade -y
clipboard, clips, clip history      = clipkey
packages                            = pkgkey
file managers                       = fmget
doctor, health check                = tdoctor
network, scan network, network scan = netkey
downloads, drop watch               = dropwatch
pipe, offset                        = offset
cardputer, card computer            = cardkey
shizuku, near root, root tools      = sukey
debloat, remove bloat               = sukey debloat
EOF
}

# lowercase, punctuation → spaces, collapse whitespace; result in REPLY
norm() {
  local s=${1,,}
  s=${s//[^a-z0-9 ]/ }
  local -a w
  read -ra w <<<"$s"
  REPLY="${w[*]}"
}

trim() {
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}
  s=${s%"${s##*[![:space:]]}"}
  REPLY=$s
}

# Parse the config into parallel arrays: line number, phrases, command
load() {
  [[ -f $CONF ]] || write_default
  E_LN=(); E_PH=(); E_CMD=()
  local ln=0 line ph
  while IFS= read -r line || [[ -n $line ]]; do
    ln=$((ln + 1))
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    [[ $line == *=* ]] || continue
    trim "${line%%=*}"; ph=$REPLY
    trim "${line#*=}"
    [[ -n $ph && -n $REPLY ]] || continue
    E_LN+=("$ln"); E_PH+=("$ph"); E_CMD+=("$REPLY")
  done < "$CONF"
}

# Find the longest phrase that appears as whole words in the text → M, MP
match() {
  local text=" $1 " i p best=0
  local -a parts
  M=-1; MP=""
  for i in "${!E_PH[@]}"; do
    IFS=',' read -ra parts <<<"${E_PH[i]}"
    for p in "${parts[@]}"; do
      norm "$p"; p=$REPLY
      [[ -n $p && $text == *" $p "* ]] || continue
      if (( ${#p} > best )); then best=${#p}; M=$i; MP=$p; fi
    done
  done
  (( M >= 0 ))
}

say() {
  [[ $SPEAK == 1 ]] || return 0
  command -v termux-tts-speak >/dev/null 2>&1 || return 0
  termux-tts-speak "$*" >/dev/null 2>&1 &
}

listen() {
  if ! command -v termux-speech-to-text >/dev/null 2>&1 && [[ -t 0 ]] &&
     command -v pkg >/dev/null 2>&1; then
    echo "Installing termux-api…"; pkg install -y termux-api
  fi
  command -v termux-speech-to-text >/dev/null 2>&1 ||
    die "termux-api missing — run: pkg install termux-api"
  { termux-vibrate -d 50 >/dev/null 2>&1 & } 2>/dev/null
  printf '%s' "${C}🎤 listening…${N} "
  local out
  out=$(timeout 25 termux-speech-to-text 2>/dev/null)
  # The recognizer streams partial guesses; the last line is the final one.
  HEARD=$(printf '%s\n' "$out" | sed '/^[[:space:]]*$/d' | tail -n 1)
  norm "$HEARD"; HEARD=$REPLY
  echo "${D}\"$HEARD\"${N}"
}

run_entry() {
  local i=$1
  echo "${G}▶${N} ${E_CMD[i]}"
  say "${2:-okay}"
  "${SHELL:-bash}" -ic "${E_CMD[i]}"
}

show_list() {
  local i
  echo "${C}Say any of these:${N}"
  for i in "${!E_PH[@]}"; do
    printf '  %s%s%s\n     %s→ %s%s\n' "$G" "${E_PH[i]}" "$N" "$D" "${E_CMD[i]}" "$N"
  done
  printf '  %sstop%s\n     %s→ ends loop mode%s\n' "$G" "$N" "$D" "$N"
}

# Add a heard phrase to an existing entry's line in the config
learn() {
  local i=$1 p=$2
  sed -i -E "${E_LN[i]}s/^([^=]*[^[:space:]=])[[:space:]]*=/\\1, ${p} =/" "$CONF"
  E_PH[i]+=", $p"
  echo "${G}✓${N} learned: \"$p\" → ${E_CMD[i]}"
}

fallback() {
  local heard=$1 sel i a
  command -v fzf >/dev/null 2>&1 || return 1
  sel=$(for i in "${!E_PH[@]}"; do
          printf '%s\t%s\t%s\n' "$i" "${E_PH[i]}" "${E_CMD[i]}"
        done | fzf --delimiter=$'\t' --with-nth=2,3 --layout=reverse --height=60% \
                   --prompt='run instead> ' \
                   --header="no match for \"$heard\" — pick one, or esc to skip") || return 1
  i=${sel%%$'\t'*}
  if [[ -n $heard ]]; then
    read -rp "Teach it: \"$heard\" runs this from now on? [Y/n] " a
    [[ $a == [nN]* ]] || learn "$i" "$heard"
  fi
  run_entry "$i" "${E_PH[i]%%,*}"
}

is_stop() {
  case $1 in
    stop|exit|quit|bye|goodbye|cancel|nevermind|"never mind"|"stop listening") return 0 ;;
  esac
  return 1
}

# Returns 2 when told to stop
handle() {
  local text=$1
  if [[ -z $text ]]; then
    echo "${Y}?${N} didn't catch that"; say "didn't catch that"; return 1
  fi
  if is_stop "$text"; then echo "bye"; say "bye"; return 2; fi
  case $text in
    help|commands|"list commands"|"what can you do") show_list; return 0 ;;
  esac
  if match "$text"; then run_entry "$M" "$MP"; return; fi
  echo "${Y}?${N} no command for \"$text\""
  say "not sure what that is"
  fallback "$text"
}

loop() {
  echo "${D}Voice mode — say \"stop\" when you're done.${N}"
  local rc misses=0
  while :; do
    listen
    if [[ -z $HEARD ]]; then
      misses=$((misses + 1))
      if (( misses >= 3 )); then echo "Nothing heard 3 times in a row — stopping."; break; fi
      continue
    fi
    misses=0
    handle "$HEARD"; rc=$?
    (( rc == 2 )) && break
  done
}

add_cmd() {
  (( $# >= 2 )) || die 'usage: talk add "phrase" "command"'
  local ph=$1; shift
  [[ $ph == *=* ]] && die "a phrase can't contain ="
  [[ -f $CONF ]] || write_default
  printf '%-35s = %s\n' "$ph" "$*" >> "$CONF"
  echo "${G}✓${N} \"$ph\" → $*"
}

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$SELF"; }

if [[ ${1:-} == -q ]]; then SPEAK=0; shift; fi

case "${1:-}" in
  "")              load; listen; handle "$HEARD" ;;
  loop|-l)         load; loop ;;
  add)             shift; add_cmd "$@" ;;
  list|ls)         load; show_list ;;
  edit)            [[ -f $CONF ]] || write_default; "${EDITOR:-nano}" "$CONF" ;;
  -h|--help)       usage ;;
  *)               load; norm "$*"; handle "$REPLY" ;;
esac
