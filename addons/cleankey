#!/usr/bin/env bash
# cleankey — what's safe to delete in Termux, with undo  (t-launcher add-on)
#
#   cleankey                  menu: home folder, ~/bin, Download, trash
#   cleankey home|bin|dl      look through one place
#   cleankey why <path>       is this safe to delete? what uses it?
#   cleankey trash <path>...  move things to the trash (asks first)
#   cleankey undo [--last]    put things back from the trash
#   cleankey list             what's in the trash
#   cleankey empty            delete the trash for good (asks first)
#   cleankey scan [where]     plain report, no menus
#
# Every item gets a label, and the reason for it:
#   KEEP   Termux or your tools need it      (moving it means typing "yes")
#   CHECK  could be in use, or unknown       (look at "used by" first)
#   SAFE   caches, broken links, unfinished or duplicate downloads
#
# Rules it never breaks:
#   - nothing is deleted except by "cleankey empty", and that always asks
#   - "delete" means move to the trash; if that fails it stops, it never falls back to rm
#   - never moves ~/storage (it leads to your real phone files) and never scans through it
#   - only works inside your home folder and Download, checked on the real path,
#     so ~/storage/downloads/x counts as Download, but ~/storage/dcim/x is refused
#   - "nothing found" only means nothing found: it says exactly what it checked
# ============================================================

set -u

VERSION=1
SELF=$(readlink -f "${BASH_SOURCE[0]}")
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/cleankey"
HTRASH="$DATA/trash"                       # trash for things in your home folder
LOG="$DATA/trash.log"                      # id <TAB> when <TAB> original <TAB> in-trash <TAB> KB
HIST="$DATA/history.log"
SHARED="${CLEANKEY_SHARED:-/storage/emulated/0}"
DL="$SHARED/Download"
STRASH="$SHARED/.cleankey-trash"           # trash for Download, same drive = instant
ADDONS="dropwatch cardkey netkey offset tdoctor clipkey talk sukey cleankey"
G=$'\e[1;32m'; Y=$'\e[1;33m'; R=$'\e[1;31m'; B=$'\e[1;34m'; C=$'\e[1;36m'
D=$'\e[38;5;244m'; W=$'\e[1m'; N=$'\e[0m'
[ -t 1 ] || { G=; Y=; R=; B=; C=; D=; W=; N=; }

need() { command -v "$1" >/dev/null 2>&1; }
say()  { printf '%s\n' "$*"; }
die()  { printf '%scleankey:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
tilde() { local p="$1"; [[ $p == "$HOME"* ]] && p="~${p#"$HOME"}"; [[ $p == "$SHARED"* ]] && p="/sdcard${p#"$SHARED"}"; printf '%s' "$p"; }
human() { # KB -> 1.2M
  local k="${1:-0}"
  if need numfmt; then numfmt --from-unit=1024 --to=iec "$k" 2>/dev/null || printf '%sK' "$k"
  else printf '%sK' "$k"; fi
}
kb_of() { du -sk -- "$1" 2>/dev/null | cut -f1; }
confirm() { local a; read -r -p "$1 [y/N] " a; [[ $a == [yY]* ]]; }
re_escape() { printf '%s' "$1" | sed 's/[][\.*^$+?(){}|/]/\\&/g'; }
wrap_ansi() { # word-wrap to $1 columns, not counting color codes
  awk -v w="$1" 'BEGIN { e = sprintf("%c", 27); re = e "\\[[0-9;]*m" }
  { n = split($0, a, /[ ]/); out = ""; len = 0
    for (i = 1; i <= n; i++) {
      t = a[i]; v = t; gsub(re, "", v); l = length(v)
      if (i == 1) { out = t; len = l; continue }
      if (len + 1 + l > w && len > 0 && l > 0) { print out; out = "  " t; len = 2 + l }
      else { out = out " " t; len += 1 + l }
    }
    print out }'
}
logh() { mkdir -p "$DATA"; printf '%s  %s\n' "$(date '+%F %T')" "$*" >>"$HIST"; }

TMPD=""
tmpdir() {
  [ -n "$TMPD" ] && return
  TMPD=$(mktemp -d "${TMPDIR:-/tmp}/cleankey.XXXXXX") || die "couldn't make a temp folder"
  trap 'case "$TMPD" in */cleankey.*) rm -rf -- "$TMPD" ;; esac' EXIT
}

storage_ok() {
  [ -r "$DL" ] && return 0
  if [ -t 0 ] && need termux-setup-storage; then
    say "cleankey needs storage access to look in Download. Tap Allow on the pop-up."
    termux-setup-storage; sleep 3
  fi
  [ -r "$DL" ]
}

# ---------- Where is it allowed to work? ----------
# Prints the "area" a path belongs to (home | bin | dl), or nothing if it's off limits.
area_of() {
  local p="$1"
  case "$p" in
    "$HOME"|"$HOME/"|"$HOME/storage"|"$HOME/storage/"*) return ;;   # never through ~/storage
    "$DATA"|"$DATA/"*|"$STRASH"|"$STRASH/"*) return ;;              # cleankey's own stuff
    "$HOME/bin/"*) echo bin ;;
    "$HOME/"*) echo home ;;
    "$DL/"*) echo dl ;;
  esac
}
# Absolute path without following the item itself (only its folder), so links stay links.
abspath() {
  local p="$1" d b
  [[ $p == "~/"* ]] && p="$HOME/${p#\~/}"
  p="${p%/}"; [ -n "$p" ] || p=/
  case "$p" in /*) ;; *) p="$PWD/$p" ;; esac
  d=$(dirname -- "$p"); b=$(basename -- "$p")
  d=$(cd -- "$d" 2>/dev/null && pwd -P) || { printf '%s' "$p"; return; }
  # keep paths through Download in their real form
  printf '%s/%s' "${d%/}" "$b"
}

# ---------- What does something use? ----------
# One pass over every file that could mention things, saved as  file:line:text
CHECKED="shell startup files, ~/.termux, ~/.shortcuts, ~/bin, ~/.config, cron"
build_corpus() {
  tmpdir
  CORPUS="$TMPD/corpus"; : >"$CORPUS"
  {
    local x
    for x in .zshrc .bashrc .profile .bash_profile .zprofile .zshenv .zlogin .bash_aliases .zsh_aliases .p10k.zsh .tmux.conf; do
      [ -f "$HOME/$x" ] && printf '%s\0' "$HOME/$x"
    done
    find "$HOME/.termux" "$HOME/.shortcuts" "$HOME/bin" "$HOME/.config" -maxdepth 3 \
      -type f -size -512k -print0 2>/dev/null
    find "${PREFIX:-/data/data/com.termux/files/usr}/var/spool/cron" -type f -print0 2>/dev/null
  } | xargs -0 -r grep -nIH '' -- 2>/dev/null >"$CORPUS"
}

# refs_for PATH AREA  -> REFS=( "file:line  text" ... ), REFN = count
refs_for() {
  local p="$1" area="$2" rel en hp cand f ln text re
  REFS=(); REFN=0
  [ -s "${CORPUS:-}" ] || return 0
  hp=$(re_escape "$HOME")
  local tail='([^A-Za-z0-9._-]|$)'
  case "$area" in
    home|bin)
      rel="${p#"$HOME"/}"; en=$(re_escape "$rel")
      re="(~|\\\$HOME|\\\$\\{HOME\\}|$hp)/$en$tail" ;;
    dl)
      rel="${p#"$DL"/}"; en=$(re_escape "$rel")
      re="(/sdcard/Download|/storage/emulated/0/Download|$(re_escape "$DL")|storage/downloads)/$en$tail" ;;
    *) return 0 ;;
  esac
  local bare=""   # ~/bin commands are also used by name alone
  [ "$area" = bin ] && bare="(^|[^A-Za-z0-9._/-])$(re_escape "${p##*/}")$tail"
  while IFS= read -r cand; do
    f="${cand%%:*}"; cand="${cand#*:}"; ln="${cand%%:*}"; text="${cand#*:}"
    [ "$f" = "$p" ] && continue                       # it mentioning itself doesn't count
    [[ $f == "$p/"* ]] && continue                    # nor files inside it
    [[ $text =~ ^[[:space:]]*# ]] && continue         # comments aren't uses
    if [[ $text =~ $re ]]; then :
    elif [ -n "$bare" ] && [[ $f != "$HOME/.config/"* ]] && [[ $text =~ $bare ]]; then :
    else continue; fi
    REFN=$((REFN + 1))
    if [ "$REFN" -le 4 ]; then
      text="${text#"${text%%[![:space:]]*}"}"
      REFS+=("$(tilde "$f"):$ln  ${text:0:70}")
    fi
  done < <(grep -F -- "${p##*/}" "$CORPUS" 2>/dev/null; true)
}

# ---------- What is it? ----------
kind_of() {
  local p="$1" b="${1##*/}" n t
  if [ -L "$p" ]; then
    t=$(readlink -- "$p")
    if [ -e "$p" ]; then KIND="link → $(tilde "$t")"; else KIND="broken link → $(tilde "$t")"; fi
    return
  fi
  if [ -d "$p" ]; then
    n=$(find "$p" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)
    KIND="folder · $n item$([ "$n" = 1 ] || echo s)"; return
  fi
  case "${b,,}" in
    *.sh|*.bash|*.zsh) KIND="shell script" ;;
    *.py) KIND="python script" ;;  *.js) KIND="javascript" ;;
    *.apk) KIND="Android app installer" ;; *.deb) KIND="package installer" ;;
    *.appimage) KIND="AppImage (Linux app)" ;;
    *.zip|*.tar|*.gz|*.tgz|*.xz|*.bz2|*.7z|*.rar|*.zst) KIND="archive" ;;
    *.jpg|*.jpeg|*.png|*.gif|*.webp|*.heic) KIND="image" ;;
    *.mp4|*.mkv|*.webm|*.mov|*.3gp) KIND="video" ;;
    *.mp3|*.m4a|*.flac|*.wav|*.ogg|*.opus) KIND="audio" ;;
    *.pdf|*.doc|*.docx|*.xls|*.xlsx|*.odt|*.epub) KIND="document" ;;
    *.bin|*.img|*.hex) KIND="firmware / binary image" ;;
    *.txt|*.md|*.log|*.csv) KIND="text" ;;
    *.json|*.yml|*.yaml|*.conf|*.cfg|*.ini|*.toml) KIND="settings / data file" ;;
    *.part|*.crdownload|*.download|*.tmp) KIND="unfinished download / temp file" ;;
    *) if [ -x "$p" ]; then KIND="program / script"
       elif need file; then KIND=$(file -b -- "$p" 2>/dev/null | cut -c1-40)
       else KIND="file"; fi ;;
  esac
}

# ---------- The label, and why ----------
setl() { LABEL="$1"; WHY="$2"; }
DUPRE='^(.*[^ ]) ?\(([0-9]+)\)(\.[A-Za-z0-9]+)?$'   # "photo (1).jpg" -> photo .jpg
classify() { # classify PATH AREA -> LABEL WHY KIND REFS REFN
  local p="$1" area="$2" b="${1##*/}" o
  kind_of "$p"
  refs_for "$p" "$area"
  setl CHECK "not something I recognize — have a look first"
  CACHE=0

  if [ -L "$p" ] && [ ! -e "$p" ]; then
    setl SAFE "broken link — what it pointed to is gone"
  elif [ -L "$p" ]; then
    setl CHECK "a shortcut (link) — only the link would move, not what it points to"
  elif [ "$area" = home ]; then
    case "$b" in
      .termux)          setl KEEP "Termux's own settings, keys and boot scripts" ;;
      .ssh)             setl KEEP "SSH keys — can't be recreated" ;;
      .gnupg)           setl KEEP "encryption keys" ;;
      .config)          setl KEEP "settings for your apps and tools" ;;
      .local)           setl KEEP "tools keep their data here (incl. sukey's undo log)" ;;
      .toolkit-backup)  setl KEEP "backups made by t-launcher's installer" ;;
      .git)             setl KEEP "git history for your home folder" ;;
      bin)              setl KEEP "your own commands (look inside: cleankey bin)" ;;
      .termux_authinfo) setl KEEP "your Termux SSH login password" ;;
      .shortcuts)       setl KEEP "Termux:Widget home-screen shortcuts" ;;
      .zshrc|.bashrc|.profile|.bash_profile|.zprofile|.zshenv|.zlogin|.bash_aliases|.zsh_aliases|.inputrc|.nanorc|.tmux.conf|.p10k.zsh|.gitconfig|.vimrc|.npmrc|.wgetrc|.curlrc|.gitignore)
                        setl KEEP "settings your shell or apps read" ;;
      .oh-my-zsh|.zsh|.zinit|.zim|.antigen|.tmux|.fzf)
                        setl KEEP "add-ons your shell or tmux loads" ;;
      .cache)           setl SAFE "cache — programs rebuild it when needed"; CACHE=1 ;;
      .npm)             setl SAFE "npm's download cache and logs"; CACHE=1 ;;
      .zcompdump*)      setl SAFE "zsh completion cache, rebuilt next start"; CACHE=1 ;;
      .lesshst|.wget-hsts|.viminfo|.sudo_as_admin_successful)
                        setl SAFE "small history file, recreated automatically" ;;
      .zsh_history|.bash_history|.python_history|.node_repl_history|.sqlite_history)
                        setl CHECK "your command history — Termux won't miss it, but you might" ;;
      *.part|*.crdownload|*.download|*.tmp)
                        setl SAFE "unfinished download / temp file" ;;
      .*)               setl CHECK "unknown settings file — leave it unless you know it" ;;
    esac
  elif [ "$area" = bin ]; then
    case " $ADDONS " in *" $b "*) setl KEEP "t-launcher add-on" ;; *)
      if [ "$b" = rish ] && grep -q 'installed by sukey' "$p" 2>/dev/null; then
        setl KEEP "sukey's bridge to Shizuku"
      elif [[ $b == *.bak ]]; then setl CHECK "backup copy of ${b%.bak}"
      else setl CHECK "one of your commands"; fi ;;
    esac
  elif [ "$area" = dl ]; then
    if [[ ${b,,} =~ \.(part|crdownload|download|tmp)$ ]]; then
      setl SAFE "unfinished download"
    elif [ -f "$p" ] && [ ! -s "$p" ]; then
      setl SAFE "empty file"
    elif [ -d "$p" ] && [ -z "$(ls -A -- "$p" 2>/dev/null)" ]; then
      setl SAFE "empty folder"
    elif [[ $b =~ $DUPRE ]] && [ -e "$DL/${BASH_REMATCH[1]}${BASH_REMATCH[3]}" ]; then
      o="${BASH_REMATCH[1]}${BASH_REMATCH[3]}"
      if [ -f "$p" ] && cmp -s -- "$p" "$DL/$o"; then setl SAFE "exact copy of $o"
      else setl CHECK "another version of $o"; fi
    else
      o=""
      if [ -f "$p" ]; then
        for c in "$HOME/bin/${b%.*}" "$HOME/bin/$b"; do
          [ -f "$c" ] && cmp -s -- "$p" "$c" && { o="$c"; break; }
        done
      fi
      if [ -n "$o" ]; then setl SAFE "already installed as $(tilde "$o")"
      else
        case "${b,,}" in
          *.apk|*.deb|*.appimage) setl CHECK "installer — keep it if you might reinstall" ;;
          *) setl CHECK "a download — only you know if you still need it" ;;
        esac
      fi
    fi
  fi

  # Something mentions it: that beats SAFE, and gets shown as the reason
  # (caches are the exception: settings pointing *into* a cache don't stop it being a cache)
  if [ "$REFN" -gt 0 ] && [ "$LABEL" != KEEP ] && [ "$CACHE" = 0 ]; then
    LABEL=CHECK
    WHY="used by ${REFS[0]%%:*}$([ "$REFN" -gt 1 ] && echo " (+$((REFN - 1)) more)")"
  fi
}

details() { # details PATH AREA KB   (classify must have run)
  local p="$1" area="$2" kb="$3" col r
  case "$LABEL" in KEEP) col=$B ;; CHECK) col=$Y ;; *) col=$G ;; esac
  printf '%s%s%s\n' "$W" "${p##*/}" "$N"
  printf '%s%s%s · %s\n\n' "$col" "$LABEL" "$N" "$WHY"
  printf '%swhat %s %s\n' "$D" "$N" "$KIND"
  printf '%ssize %s %s · changed %s\n' "$D" "$N" "$(human "$kb")" "$(date -r "$p" '+%b %d %Y' 2>/dev/null)"
  printf '%swhere%s %s\n\n' "$D" "$N" "$(tilde "$p")"
  if [ "$REFN" -gt 0 ] && [ "${CACHE:-0}" = 1 ]; then
    printf '%smentioned in%s %s(paths inside a cache, still fine to clear)%s\n' "$Y" "$N" "$D" "$N"
    for r in "${REFS[@]}"; do printf '  %s\n' "$r"; done
  elif [ "$REFN" -gt 0 ]; then
    printf '%sused by%s\n' "$Y" "$N"
    for r in "${REFS[@]}"; do printf '  %s\n' "$r"; done
    [ "$REFN" -gt 4 ] && printf '  %s(+%s more)%s\n' "$D" "$((REFN - 4))" "$N"
  else
    printf 'used by: %snothing found%s\n' "$W" "$N"
  fi
  printf '%schecked: %s · comments ignored%s\n' "$D" "$CHECKED" "$N"
  [ "$REFN" -eq 0 ] && printf '%s"nothing found" doesn'"'"'t prove nothing needs it: you might run it by hand, or another app might.%s\n' "$D" "$N"
  printf '\n'
  if [ -z "$(area_of "$p")" ]; then
    printf '%scleankey never moves this one.%s\n' "$R" "$N"
  elif [ "$LABEL" = KEEP ]; then
    printf '%sMoving it means typing yes. Still goes to the trash, with undo.%s\n' "$D" "$N"
  elif [ "${UI:-1}" = 1 ]; then
    printf '%sEnter moves it to the trash. Undo any time.%s\n' "$D" "$N"
  else
    printf '%sTo move it: cleankey trash %s   (undo any time)%s\n' "$D" "$(tilde "$p" | sed 's/[ ()]/\\&/g')" "$N"
  fi
}

# ---------- Scanning a place ----------
# fills arrays P (path) L (label) Y (why) K (kb), sorted SAFE, CHECK, KEEP, biggest first
scan_place() { # scan_place AREA
  local area="$1" root x kb i=0 order
  case "$area" in home) root="$HOME" ;; bin) root="$HOME/bin" ;; dl) root="$DL" ;; esac
  build_corpus
  FW=$(( $(cols) - 2 )); ((FW < 30)) && FW=30
  mkdir -p "$TMPD/d"; rm -f "$TMPD/d/"* "$TMPD/rows" 2>/dev/null
  while IFS= read -r -d '' x; do
    [[ $x == *$'\n'* || $x == *$'\t'* ]] && continue
    if [ "$area" = home ] && [ "${x##*/}" = storage ]; then
      LABEL=KEEP; WHY="links to your phone's storage — never touched"; KIND="link → phone storage"; REFS=(); REFN=0
    else
      classify "$x" "$area"
    fi
    kb=$(kb_of "$x"); kb=${kb:-0}
    case "$LABEL" in SAFE) order=1 ;; CHECK) order=2 ;; *) order=3 ;; esac
    i=$((i + 1))
    details "$x" "$area" "$kb" | wrap_ansi "$FW" >"$TMPD/d/$i"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$order" "$kb" "$i" "$LABEL" "$x" "$WHY" >>"$TMPD/rows"
  done < <(find "$root" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
  P=(); L=(); Yw=(); K=(); IDX=()
  [ -f "$TMPD/rows" ] || return 0
  local o k id lab path why
  while IFS=$'\t' read -r o k id lab path why; do
    mv -f -- "$TMPD/d/$id" "$TMPD/d/s${#P[@]}"
    IDX+=("$id"); K+=("$k"); L+=("$lab"); P+=("$path"); Yw+=("$why")
  done < <(sort -t $'\t' -k1,1n -k2,2nr "$TMPD/rows")
}

cols() { local r c; read -r r c < <({ stty size </dev/tty; } 2>/dev/null); [[ ${c:-} =~ ^[0-9]+$ ]] || c=50; printf '%s' "$c"; }

rows_for_fzf() {
  local i nw n col name sz
  nw=$(( $(cols) - 34 )); ((nw > 24)) && nw=24; ((nw < 12)) && nw=12
  for i in "${!P[@]}"; do
    case "${L[i]}" in KEEP) col=$D ;; CHECK) col=$Y ;; *) col=$G ;; esac
    name="${P[i]##*/}"; [ -d "${P[i]}" ] && [ ! -L "${P[i]}" ] && name+="/"
    n=${#name}; ((n > nw)) && name="${name:0:$((nw - 1))}…"
    sz=$(human "${K[i]}")
    printf '%s\t%s%-5s%s %-*s %5s  %s%s%s\n' "$i" "$col" "${L[i]}" "$N" "$nw" "$name" "$sz" "$D" "${Yw[i]}" "$N"
  done
}

# ---------- Trash ----------
trash_root_for() { case "$1" in "$SHARED/"*) echo "$STRASH" ;; *) echo "$HTRASH" ;; esac; }

# move_one PATH -> 0 moved, 1 failed (nothing deleted either way)
move_one() {
  local p="$1" name="${1##*/}" root id dest kb
  root=$(trash_root_for "$p")
  id="$(date +%Y%m%d-%H%M%S)-$$-$RANDOM"
  dest="$root/$id/$name"
  mkdir -p "$root/$id" 2>/dev/null || { say "${R}Couldn't make the trash folder $(tilde "$root"). Nothing was deleted.${N}"; return 1; }
  [ "$root" = "$STRASH" ] && [ ! -e "$STRASH/.nomedia" ] && : >"$STRASH/.nomedia" 2>/dev/null   # keep trashed photos out of the gallery
  kb=$(kb_of "$p"); kb=${kb:-0}
  if mv -n -- "$p" "$dest" 2>"$root/$id/.err" && [ ! -e "$p" ] && [ ! -L "$p" ] && { [ -e "$dest" ] || [ -L "$dest" ]; }; then
    rm -f -- "$root/$id/.err"
    mkdir -p "$DATA"
    printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$(date '+%F %R')" "$p" "$dest" "$kb" >>"$LOG"
    logh "trashed $p"
    say "${G}✓${N} $(tilde "$p") → trash"
    return 0
  fi
  say "${R}Couldn't move $(tilde "$p") to the trash:${N} $(head -c 200 "$root/$id/.err" 2>/dev/null)"
  say "Nothing was deleted. Stopping here."
  rm -f -- "$root/$id/.err"; rmdir -- "$root/$id" 2>/dev/null
  return 1
}

# trash_paths PATH...  -> asks, then moves; stops at the first failure
trash_paths() {
  local p a area n=0 keep=0 kb tot=0
  local -a ok=()
  build_corpus
  for p in "$@"; do
    [[ $p == "~/"* ]] && p="$HOME/${p#\~/}"
    [ -e "$p" ] || [ -L "$p" ] || { say "${Y}Not found:${N} $p"; continue; }
    p=$(abspath "$p"); area=$(area_of "$p")
    if [ "$p" = "$HOME/storage" ]; then
      say "${R}Won't move ~/storage:${N} it leads to your real phone files."; continue
    fi
    if [ -z "$area" ]; then
      say "${R}Won't move $(tilde "$p"):${N} cleankey only works inside your home folder and Download (and never on its own trash)."
      continue
    fi
    classify "$p" "$area"
    kb=$(kb_of "$p"); kb=${kb:-0}; tot=$((tot + kb))
    [ "$LABEL" = KEEP ] && keep=$((keep + 1))
    local col; case "$LABEL" in KEEP) col=$B ;; CHECK) col=$Y ;; *) col=$G ;; esac
    printf '  %s%-5s%s %6s  %s\n        %s%s%s\n' "$col" "$LABEL" "$N" "$(human "$kb")" "$(tilde "$p")" "$D" "$WHY" "$N"
    ok+=("$p"); n=$((n + 1))
  done
  [ "$n" -gt 0 ] || return 1
  printf '\n%sMove %s item%s (%s) to the trash? You can undo it: cleankey undo%s\n' \
    "$W" "$n" "$([ "$n" = 1 ] || echo s)" "$(human "$tot")" "$N"
  if [ "$keep" -gt 0 ]; then
    local a; read -r -p "${B}KEEP${N} items are in there: Termux or your tools need them. Type yes to move them anyway: " a
    [ "$a" = yes ] || { say "Nothing moved."; return 1; }
  else
    confirm "Go ahead?" || { say "Nothing moved."; return 1; }
  fi
  for p in "${ok[@]}"; do move_one "$p" || return 1; done
  return 0
}

log_lines() { [ -s "$LOG" ] && tac "$LOG"; }   # newest first

restore_id() { # restore_id ID -> puts it back (never overwrites)
  local id="$1" line wid when orig tpath kb target n=1
  line=$(grep -m1 "^$id"$'\t' "$LOG" 2>/dev/null) || { say "No trash entry $id"; return 1; }
  IFS=$'\t' read -r wid when orig tpath kb <<<"$line"
  if [ ! -e "$tpath" ] && [ ! -L "$tpath" ]; then
    say "${Y}$(tilde "$orig") isn't in the trash any more (emptied?).${N}"
    grep -v "^$id"$'\t' "$LOG" >"$LOG.tmp"; mv -f "$LOG.tmp" "$LOG"; return 1
  fi
  target="$orig"
  while [ -e "$target" ] || [ -L "$target" ]; do   # something new is there: don't overwrite it
    target="${orig} (restored$([ "$n" -gt 1 ] && echo " $n"))"; n=$((n + 1))
  done
  mkdir -p -- "${orig%/*}" || { say "${R}Couldn't recreate $(tilde "${orig%/*}").${N}"; return 1; }
  if mv -n -- "$tpath" "$target"; then
    rmdir -- "${tpath%/*}" 2>/dev/null
    grep -v "^$id"$'\t' "$LOG" >"$LOG.tmp"; mv -f "$LOG.tmp" "$LOG"
    logh "restored $target"
    say "${G}✓${N} put back: $(tilde "$target")"
    [ "$target" != "$orig" ] && say "  (something new was at $(tilde "$orig"), so it came back with a different name)"
    return 0
  fi
  say "${R}Couldn't put $(tilde "$orig") back.${N} It's still safe in the trash."; return 1
}

trash_summary() { # -> "N items · SIZE"
  local n=0 kb=0 id when orig tp k
  while IFS=$'\t' read -r id when orig tp k; do [ -n "$id" ] || continue; n=$((n + 1)); kb=$((kb + ${k:-0})); done < <(log_lines)
  printf '%s item%s · %s' "$n" "$([ "$n" = 1 ] || echo s)" "$(human "$kb")"
}

cmd_list() {
  local id when orig tp kb any=0
  while IFS=$'\t' read -r id when orig tp kb; do
    [ -n "$id" ] || continue; any=1
    printf '%s  %6s  %s\n' "$when" "$(human "$kb")" "$(tilde "$orig")"
  done < <(log_lines)
  [ "$any" = 1 ] || say "The trash is empty."
}

cmd_empty() {
  [ -s "$LOG" ] || { say "The trash is empty."; return 0; }
  say "${W}In the trash:${N} $(trash_summary)"
  cmd_list | head -15
  printf '\n%sDelete all of it for good? This is the only thing cleankey ever deletes, and it can'"'"'t be undone.%s\n' "$R" "$N"
  confirm "Empty the trash?" || { say "Kept everything."; return 1; }
  local root
  for root in "$HTRASH" "$STRASH"; do
    case "$root" in */cleankey/trash|*/.cleankey-trash) ;; *) continue ;; esac   # paranoia: only ever these two
    [ -d "$root" ] || continue
    find "$root" -mindepth 1 -maxdepth 1 ! -name .nomedia -exec rm -rf -- {} + 2>/dev/null
  done
  : >"$LOG"; logh "emptied trash"
  say "${G}✓${N} Trash emptied."
}

cmd_undo() {
  [ -s "$LOG" ] || { say "The trash is empty, nothing to undo."; return 0; }
  if [ "${1:-}" = --last ]; then restore_id "$(tail -n1 "$LOG" | cut -f1)"; return; fi
  need fzf || die "needs fzf: pkg install fzf"
  local sel id when orig tp kb from
  sel=$(while IFS=$'\t' read -r id when orig tp kb; do
          [ -n "$id" ] || continue
          from=$(tilde "${orig%/*}")
          printf '%s\t%-20s %5s  %sfrom %s · %s%s\n' "$id" "${orig##*/}" "$(human "$kb")" "$D" "$from" "${when:5}" "$N"
        done < <(log_lines) \
    | fzf "${FZ[@]}" --multi --no-hscroll --delimiter=$'\t' --with-nth=2 \
        --header="Tab pick · Enter put back · Esc cancel" ${LBL:+--border-label=" Trash · undo "}) || return 0
  while IFS=$'\t' read -r id _; do [ -n "$id" ] && restore_id "$id"; done <<<"$sel"
}

cmd_why() {
  local p area kb
  [ -n "${1:-}" ] || die "usage: cleankey why <path>"
  p="$1"; [[ $p == "~/"* ]] && p="$HOME/${p#\~/}"
  [ -e "$p" ] || [ -L "$p" ] || die "not found: $1"
  p=$(abspath "$p"); area=$(area_of "$p"); UI=0
  build_corpus
  if [ "$p" = "$HOME/storage" ] || [[ $p == "$HOME/storage/"* ]]; then
    LABEL=KEEP; WHY="links to your phone's storage — never touched"; KIND="link"; REFS=(); REFN=0
  else
    classify "$p" "${area:-none}"
    [ -z "$area" ] && { LABEL=KEEP; WHY="outside cleankey's area (home folder and Download only)"; }
  fi
  kb=$(kb_of "$p")
  if [ -t 1 ]; then details "$p" "${area:-none}" "${kb:-0}" | wrap_ansi "$(( $(cols) - 1 ))"
  else details "$p" "${area:-none}" "${kb:-0}"; fi
}

cmd_scan() {
  local area="${1:-home}" i
  [ "$area" = dl ] && { storage_ok || die "can't read $DL (run termux-setup-storage)"; }
  scan_place "$area"
  for i in "${!P[@]}"; do
    printf '%-5s %6s  %-26s %s\n' "${L[i]}" "$(human "${K[i]}")" "${P[i]##*/}" "${Yw[i]}"
  done
  printf '\nchecked: %s · comments ignored\n' "$CHECKED"
}

# ---------- Menus (fzf) ----------
FZ=(--reverse --ansi --cycle --prompt='› ' --pointer='▌'
  --color='fg:252,fg+:255,bg+:236,hl:214,hl+:214,prompt:51,pointer:51,info:244,header:244,marker:214')
LBL=""
if need fzf; then
  v=$(fzf --version 2>/dev/null); v=${v%% *}; maj=${v%%.*}; min=${v#*.}; min=${min%%.*}
  if [[ $maj =~ ^[0-9]+$ && $min =~ ^[0-9]+$ ]] && [ $((maj * 1000 + min)) -ge 42 ]; then
    LBL=1; FZ+=(--info=inline-right --border=top --color='border:240,label:51')
  fi
fi

place_screen() { # place_screen AREA
  local area="$1" title out key sel ids i nS nC nK hdr
  case "$area" in home) title="Home folder" ;; bin) title="~/bin" ;; dl) title="Download" ;; esac
  if [ "$area" = dl ] && ! storage_ok; then say "Can't read Download. Run termux-setup-storage first."; read -rsn1; return; fi
  while true; do
    printf '%sLooking through %s…%s\r' "$D" "$title" "$N"
    scan_place "$area"
    nS=0; nC=0; nK=0
    for i in "${L[@]}"; do case "$i" in SAFE) nS=$((nS+1)) ;; CHECK) nC=$((nC+1)) ;; *) nK=$((nK+1)) ;; esac; done
    hdr="${G}SAFE $nS${N} · ${Y}CHECK $nC${N} · ${D}KEEP $nK${N}"$'\n'"Tab pick · Enter trash · ^U undo · Esc back"
    out=$(rows_for_fzf | fzf "${FZ[@]}" --multi --no-hscroll --delimiter=$'\t' --with-nth=2.. \
      --header="$hdr" --expect=ctrl-u \
      --preview "cat $(printf '%q' "$TMPD")/d/s{1}" --preview-window=down,55%,border-top \
      ${LBL:+--border-label=" cleankey · $title "}) || return 0
    key="${out%%$'\n'*}"; sel="${out#*$'\n'}"
    [ "$key" = ctrl-u ] && { clear; cmd_undo; read -rsn1 -p "${D}any key…${N}"; continue; }
    [ -n "$sel" ] && [ "$sel" != "$out" ] || continue
    local -a pick=()
    while IFS=$'\t' read -r i _; do [ -n "$i" ] && pick+=("${P[i]}"); done <<<"$sel"
    clear
    trash_paths "${pick[@]}"
    read -rsn1 -p "${D}any key…${N}"; echo
  done
}

trash_screen() {
  local c
  while true; do
    c=$( { printf 'undo\t%sUNDO%s   Put things back\n' "$G" "$N"
           printf 'list\t%sLIST%s   What'"'"'s in it\n' "$C" "$N"
           printf 'empty\t%sEMPTY%s  Delete it for good (asks)\n' "$R" "$N"; } \
         | fzf "${FZ[@]}" --delimiter=$'\t' --with-nth=2 --header="$(trash_summary)" ${LBL:+--border-label=" Trash "}) || return 0
    clear
    case "${c%%$'\t'*}" in
      undo) cmd_undo ;; list) cmd_list ;; empty) cmd_empty ;;
    esac
    read -rsn1 -p "${D}any key…${N}"; echo
  done
}

main_menu() {
  need fzf || die "needs fzf: pkg install fzf"
  local c nh nb nd
  while true; do
    nh=$(find "$HOME" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)
    nb=$(find "$HOME/bin" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)
    nd=$( [ -r "$DL" ] && find "$DL" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l || echo "?")
    c=$( { printf 'home\t%sHOME%s   Home folder        %s~ · %s items%s\n' "$B" "$N" "$D" "$nh" "$N"
           printf 'bin\t%sBIN%s    My commands        %s~/bin · %s%s\n' "$G" "$N" "$D" "$nb" "$N"
           printf 'dl\t%sDL%s     Downloads          %s/sdcard/Download · %s%s\n' "$C" "$N" "$D" "$nd" "$N"
           printf 'trash\t%sTRASH%s  Trash              %s%s%s\n' "$Y" "$N" "$D" "$(trash_summary)" "$N"; } \
         | fzf "${FZ[@]}" --delimiter=$'\t' --with-nth=2 \
             --header="What's safe to delete, with undo · Esc = quit" ${LBL:+--border-label=" cleankey "}) || return 0
    case "${c%%$'\t'*}" in
      home|bin|dl) place_screen "${c%%$'\t'*}" ;;
      trash) trash_screen ;;
    esac
  done
}

usage() { sed -n '2,25p' "$SELF" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  "")            main_menu ;;
  home|bin|dl)   need fzf || die "needs fzf: pkg install fzf"; tmpdir; place_screen "$1" ;;
  why)           shift; cmd_why "$@" ;;
  trash)         shift; [ $# -gt 0 ] || die "usage: cleankey trash <path>..."; trash_paths "$@" ;;
  undo)          shift; cmd_undo "$@" ;;
  list)          cmd_list ;;
  empty)         cmd_empty ;;
  scan)          shift; cmd_scan "$@" ;;
  --about)       printf 'cleankey\twhat'"'"'s safe to delete, with undo\tfzf\n' ;;
  -v|--version)  echo "cleankey v$VERSION" ;;
  -h|--help|help) usage ;;
  *)             die "unknown command: $1 (try: cleankey help)" ;;
esac
